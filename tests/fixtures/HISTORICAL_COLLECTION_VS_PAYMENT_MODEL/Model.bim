        "partitions": [
          {
            "name": "Partition",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Value.NativeQuery(#\"Oracle/oracle-host:1521/oracle_service\", \"",
                "SELECT",
                "    trx_count,",
                "    total_amount,",
                "    txn_date,",
                "    business_date,",
                "    settlement_date,",
                "    'EP-' || sp_id AS root_id,",
                "    'EP-'",
                "                    || sp_id",
                "                    || '-'",
                "                    || a.acc_off_dtl_id",
                "                                 AS sp_main_id,",
                "    CASE",
                "        WHEN sp_id IN ( '40021', '41985', '42275', '42518', '40430' ) THEN --ESC,DE,BMS,",
                "            to_char('EP-'",
                "                    || sp_id",
                "                    || '-'",
                "                    || a.acc_off_dtl_id)",
                "        ELSE",
                "            to_char('EP-' || sp_id)",
                "    END                                         AS sp_main_old_id,",
                "    sp_id,",
                "    fe_id                                       fe_ent_id,",
                "    pr.u_id                                     fe_id,",
                "    sett_bank_id,",
                "    coalesce(to_char(au_tsa_id), 'COMM')        au_tsa_id,",
                "    au_code,",
                "    coalesce(to_char(epay_budget_code), 'COMM') epay_budget_code,",
                "    channel_id,",
                "    rc_entity_pi_id,",
                "    fe.u_id                                     AS coll_bank_id,",
                "    currency,",
                "    CASE",
                "        WHEN a.rc_entity_pi_id = 21806 THEN",
                "            'TSA'",
                "        WHEN a.rc_entity_pi_id = 38803 THEN",
                "            'TSA'",
                "        WHEN a.rc_entity_pi_id = 2004  THEN",
                "            'CBE'",
                "        WHEN a.rc_entity_pi_id = 38804 THEN",
                "            'CBE'",
                "        ELSE",
                "            'Comm'",
                "    END                                         tsa_flag,",
                "    a.delivery_channel_type_id,",
                "    a.delivery_channel_id,",
                "    a.acc_off_dtl_id,",
                "    a.settlement_entity_id,",
                "    a.service_entity_id",
                "FROM",
                "    epay_txn_hist_agg a",
                "    LEFT JOIN con_fe_epay_map   fe ON a.coll_bank_id = fe.id",
                "    LEFT JOIN con_fe_epay_map   pr ON a.fe_id = pr.id\")",
                "in",
                "    Source"
              ]
            },
            "annotations": [
              {
                "name": "QueryEditorSerialization",
                "value": [
                  "<?xml version=\"1.0\" encoding=\"UTF-16\"?><Gemini xmlns=\"QueryEditorSerialization\"><AnnotationContent><![CDATA[<RSQueryCommandText>let",
                  "    Source = Value.NativeQuery(#\"Oracle/oracle-host:1521/oracle_service\", \"",
                  "SELECT",
                  "    trx_count,",
                  "    total_amount,",
                  "    txn_date,",
                  "    business_date,",
                  "    settlement_date,",
                  "    sp_id,",
                  "    fe_id fe_ent_id,",
                  "    pr.u_id                                     fe_id,",
                  "    sett_bank_id,",
                  "    coalesce(to_char(au_tsa_id), 'COMM')        au_tsa_id,",
                  "    au_code,",
                  "    coalesce(to_char(epay_budget_code), 'COMM') epay_budget_code,",
                  "    channel_id,",
                  "    rc_entity_pi_id,",
                  "    fe.u_id                                     AS coll_bank_id,",
                  "    currency,",
                  "    CASE",
                  "        WHEN a.rc_entity_pi_id = 21806 THEN",
                  "            'TSA'",
                  "        WHEN a.rc_entity_pi_id = 38803 THEN",
                  "            'TSA'",
                  "        WHEN a.rc_entity_pi_id = 2004  THEN",
                  "            'CBE'",
                  "        WHEN a.rc_entity_pi_id = 38804 THEN",
                  "            'CBE'",
                  "        ELSE",
                  "            'Comm'",
                  "    END                                         tsa_flag,",
                  "    delivery_channel_type_id,",
                  "    acc_off_dtl_id",
                  "FROM",
                  "    epay_txn_hist_agg a",
                  "    LEFT JOIN con_fe_epay_map   fe ON a.coll_bank_id = fe.id",
                  "    LEFT JOIN con_fe_epay_map   pr ON a.fe_id = pr.id",
                  "",
                  "\")",
                  "in",
                  "    Source</RSQueryCommandText><RSQueryCommandType>Text</RSQueryCommandType><RSQueryDesignState></RSQueryDesignState>]]></AnnotationContent></Gemini>"
                ]
              }
            ]
          }
        ],
