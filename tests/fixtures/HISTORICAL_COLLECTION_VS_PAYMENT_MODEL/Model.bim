        "partitions": [
          {
            "name": "CalculatedTable 1",
            "source": {
              "type": "calculated",
              "expression": [
                " DATATABLE(",
                "    \"Type\", STRING,",
                "    {",
                "        {\"Business Date\"},",
                "        {\"Settlement Date\"}",
                "    }",
                ")"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "SelectedDateKey",
            "expression": [
              "",
              "VAR FilterType = SELECTEDVALUE(DateFilterType[Type])",
              "RETURN",
              "    SWITCH(",
              "        TRUE(),",
              "        FilterType = \"Business Date\", SELECTEDVALUE(DIM_DATE[CALENDAR_DATE_FORMATTED]),",
              "        FilterType = \"Settlement Date\", SELECTEDVALUE(DIM_DATE_SETT[CALENDAR_DATE_FORMATTED]),",
              "        BLANK()",
              "    )"
            ]
          }
        ]
      },
