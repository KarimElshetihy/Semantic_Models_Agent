      {
        "name": "LKP_SERVICE",
        "columns": [
          {
            "name": "SERVICE_CODE",
            "dataType": "string",
            "sourceColumn": "SERVICE_CODE"
          },
          {
            "name": "SP_ID",
            "dataType": "string",
            "sourceColumn": "SP_ID"
          },
          {
            "name": "SOURCE_SYSTEM",
            "dataType": "string",
            "sourceColumn": "SOURCE_SYSTEM"
          },
          {
            "name": "SP_NAME",
            "dataType": "string",
            "sourceColumn": "SP_NAME"
          },
          {
            "name": "SERVICE_NAME",
            "dataType": "string",
            "sourceColumn": "SERVICE_NAME"
          },
          {
            "name": "ACC_OFF_DTL_ID",
            "dataType": "string",
            "sourceColumn": "ACC_OFF_DTL_ID"
          },
          {
            "name": "SUB_SERVICE",
            "dataType": "string",
            "sourceColumn": "SUB_SERVICE"
          }
        ],
        "partitions": [
          {
            "name": "Partition",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Value.NativeQuery(#\"Oracle/oracle-host:1521/oracle_service\", \"",
                "",
                "WITH epay_gov AS (",
                "    SELECT",
                "        rb.id          biller_id,",
                "        rb.ar_name     biller_name,",
                "        rb.id          sub_biller_id,",
                "        rp.name        service_name,",
                "        rp.code        acc_off_dtl_id,",
                "        rp.rc_acc_name sub_service,",
                "        CASE",
                "            WHEN rp.rc_acc_name LIKE '%القاهرة%' THEN",
                "                'القاهرة'",
                "            WHEN rp.rc_acc_name LIKE '%الجيزة%' THEN",
                "                'الجيزة'",
                "            WHEN rp.rc_acc_name LIKE '%الإسكندرية%'",
                "                 OR rp.rc_acc_name LIKE '%الاسكندرية%' THEN",
                "                'الإسكندرية'",
                "            WHEN rp.rc_acc_name LIKE '%القليوبية%' THEN",
                "                'القليوبية'",
                "            WHEN rp.rc_acc_name LIKE '%الدقهلية%' THEN",
                "                'الدقهلية'",
                "            WHEN rp.rc_acc_name LIKE '%الشرقية%' THEN",
                "                'الشرقية'",
                "            WHEN rp.rc_acc_name LIKE '%الغربية%' THEN",
                "                'الغربية'",
                "            WHEN rp.rc_acc_name LIKE '%المنوفية%' THEN",
                "                'المنوفية'",
                "            WHEN rp.rc_acc_name LIKE '%البحيرة%' THEN",
                "                'البحيرة'",
                "            WHEN rp.rc_acc_name LIKE '%كفر الشيخ%' THEN",
                "                'كفر الشيخ'",
                "            WHEN rp.rc_acc_name LIKE '%دمياط%' THEN",
                "                'دمياط'",
                "            WHEN rp.rc_acc_name LIKE '%بورسعيد%'",
                "                 OR rp.rc_acc_name LIKE '%بور سعيد%' THEN",
                "                'بورسعيد'",
                "            WHEN rp.rc_acc_name LIKE '%الإسماعيلية%'",
                "                 OR rp.rc_acc_name LIKE '%الاسماعيلية%' THEN",
                "                'الإسماعيلية'",
                "            WHEN rp.rc_acc_name LIKE '%السويس%' THEN",
                "                'السويس'",
                "            WHEN rp.rc_acc_name LIKE '%شمال سيناء%' THEN",
                "                'شمال سيناء'",
                "            WHEN rp.rc_acc_name LIKE '%جنوب سيناء%' THEN",
                "                'جنوب سيناء'",
                "            WHEN rp.rc_acc_name LIKE '%الفيوم%' THEN",
                "                'الفيوم'",
                "            WHEN rp.rc_acc_name LIKE '%بني سويف%'",
                "                 OR rp.rc_acc_name LIKE '%بنى سويف%' THEN",
                "                'بني سويف'",
                "            WHEN rp.rc_acc_name LIKE '%المنيا%' THEN",
                "                'المنيا'",
                "            WHEN rp.rc_acc_name LIKE '%أسيوط%'",
                "                 OR rp.rc_acc_name LIKE '%اسيوط%' THEN",
                "                'أسيوط'",
                "            WHEN rp.rc_acc_name LIKE '%سوهاج%' THEN",
                "                'سوهاج'",
                "            WHEN rp.rc_acc_name LIKE '%قنا%' THEN",
                "                'قنا'",
                "            WHEN rp.rc_acc_name LIKE '%الأقصر%'",
                "                 OR rp.rc_acc_name LIKE '%الاقصر%' THEN",
                "                'الأقصر'",
                "            WHEN rp.rc_acc_name LIKE '%أسوان%'",
                "                 OR rp.rc_acc_name LIKE '%اسوان%' THEN",
                "                'أسوان'",
                "            WHEN rp.rc_acc_name LIKE '%البحر الأحمر%'",
                "                 OR rp.rc_acc_name LIKE '%البحر الاحمر%' THEN",
                "                'البحر الأحمر'",
                "            WHEN rp.rc_acc_name LIKE '%الوادي الجديد%'",
                "                 OR rp.rc_acc_name LIKE '%الوادى الجديد%' THEN",
                "                'الوادي الجديد'",
                "            WHEN rp.rc_acc_name LIKE '%مطروح%' THEN",
                "                'مطروح'",
                "            ELSE",
                "                'الديوان العام'",
                "        END            AS governorate_name",
                "    FROM",
                "        reporting_biller                rb",
                "        LEFT JOIN reporting_settlement_account_rp rp ON rb.id = rp.biller_id",
                "    WHERE",
                "        rb.id = '42008'",
                ")",
                "SELECT DISTINCT",
                "    sh.sp_id,",
                "    sh.unified_name                                sp_name,",
                "    coalesce(ep.service_name, sh.unified_name)  service_name,",
                "    sh.service_code,",
                "    coalesce(to_char(ep.acc_off_dtl_id),regexp_substr(sh.service_code, '[^-]+$', 1, 1))acc_off_dtl_id,",
                "    coalesce(ep.sub_service, sh.service_name_ar)sub_service,",
                "--    coalesce(ep.governorate_name, 'الديوان العام') governorate_name,",
                "--    sh.unit_code,",
                "    sh.source_system",
                "FROM",
                "    mdm_lkp_service_hierarchy sh",
                "    LEFT JOIN epay_gov                  ep ON regexp_substr(sh.service_code, '[^-]+$', 1, 1) = ep.acc_off_dtl_id",
                "",
                "",
                "\")",
                "in",
                "    Source"
              ]
            }
          }
        ]
      },
      {
