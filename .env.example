# Copy this file to .env and fill in your values. The .env file is git-ignored.
# Real environment variables override values in .env.
# Never put a real API key in .env.example.

# Required: the model server's address and the model name it expects.
# Localhost needs no extra setting. A network host must be listed in SSAS_AGENT_LLM_ALLOWED_HOSTS.
SSAS_AGENT_LLM_BASE_URL=http://localhost:1234/v1
SSAS_AGENT_LLM_MODEL=your-model-name

# Optional: bearer token, only if the server requires one.
# SSAS_AGENT_LLM_API_KEY=

# Optional: comma-separated network hosts the agent may send prompts to, e.g. llm.example.internal
# SSAS_AGENT_LLM_ALLOWED_HOSTS=

# Optional: allow plain http (not https) to an allowlisted network host. Default false.
# Prompts carry model metadata, so use this only on a network you trust.
# SSAS_AGENT_LLM_ALLOW_INSECURE_HTTP=false

# Optional: seconds to wait for a reply (0.1 to 3600). Default 60.
# SSAS_AGENT_LLM_TIMEOUT_SECONDS=60

# Optional: 0 to 2. Default 0.
# SSAS_AGENT_LLM_TEMPERATURE=0
