        "partitions": [
          {
            "name": "Partition",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Value.NativeQuery(#\"Oracle/oracle-host:1521/oracle_service\", \"",
                "",
                "SELECT",
                "    unit_code,",
                "    unit_name,",
                "    area_code,",
                "    area_name,",
                "    institution_code,",
                "    institution_name,",
                "    ministry_code,",
                "    ministry,",
                "    institutional_sector_code,",
                "    institutional_sector_name,",
                "    functional_sector_id,",
                "    functional_sector,",
                "    functional_child_id,",
                "    functional_child,",
                "    unit_type,",
                "    governorate_id,",
                "    is_active,",
                "    unit_tsa_id,",
                "    unit_gps_id,",
                "    effective_date_from,",
                "    effective_date_to,",
                "    source",
                "FROM",
                "    mdm_lkp_accounting_units",
                "--------------------------------------------------------------------------------",
                "UNION ALL",
                "--------------------------------------------------------------------------------",
                "SELECT",
                "    '00000000'  unit_code,",
                "    'حساب تجاري' unit_name,",
                "    '00000000'  area_code,",
                "    'حساب تجاري' area_name,",
                "    '00000000'  institution_code,",
                "    'حساب تجاري' institution_name,",
                "    'C0000'      ministry_code,",
                "    'حساب تجاري' ministry,",
                "    '00000000'  institutional_sector_code,",
                "    'حساب تجاري' institutional_sector_name,",
                "    '00000'     functional_sector_id,",
                "    'حساب تجاري' functional_sector,",
                "    '00000'     functional_child_id,",
                "    'حساب تجاري' functional_child,",
                "    'حساب تجاري' unit_type,",
                "    0            governorate_id,",
                "    1            is_active,",
                "    NULL         unit_tsa_id,",
                "    NULL         unit_gps_id,",
                "    sysdate      effective_date_from,",
                "    sysdate      effective_date_to,",
                "    'COMM'       source",
                "FROM",
                "    dual",
                "",
                "\")",
                "in",
                "    Source"
              ]
            }
          }
        ]
      }
