          },
          {
            "name": "PROJECT_NAME",
            "dataType": "string",
            "sourceColumn": "PROJECT_NAME"
          }
        ],
        "partitions": [
          {
            "name": "Partition",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Value.NativeQuery(#\"Oracle/oracle-host:1521/oracle_service\", \"",
                "",
                "SELECT",
                "        project_code,",
                "        project_name",
                "    FROM",
                "        (",
                "            SELECT DISTINCT",
                "                code project_code,",
                "                name project_name,",
                "                DENSE_RANK()",
                "                OVER(PARTITION BY code",
                "                     ORDER BY",
                "                         name",
                "                )    r",
                "            FROM",
                "                gps_payment_order_nib_project",
                "            WHERE",
                "                code IS NOT NULL",
                "        )",
                "    WHERE",
                "        r = 1",
                "",
                "\")",
                "in",
                "    Source"
              ]
            }
          }
        ]
      },
      {
        "name": "PROJECTS_APPROVED_PAYMENTS",
