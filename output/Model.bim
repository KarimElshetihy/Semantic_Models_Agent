            "dataType": "string",
            "sourceColumn": "SOURCE"
          }
        ],
        "partitions": [
          {
            "name": "Partition",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Value.NativeQuery(#\"Oracle/oracle-host:1521/oracle_service\", \"",
                "",
                "SELECT",
                "    unit_code,",
                "    unit_name,",
                "    area_code,",
                "    area_name,",
                "    institution_code,",
                "    institution_name,",
                "    ministry_code,",
                "    ministry,",
                "    institutional_sector_code,",
                "    institutional_sector_name,",
                "    functional_sector_id,",
                "    functional_sector,",
                "    functional_child_id,",
                "    functional_child,",
                "    unit_type,",
                "    governorate_id,",
                "    is_active,",
                "    unit_tsa_id,",
                "    unit_gps_id,",
                "    effective_date_from,",
                "    effective_date_to,",
                "    source",
                "FROM",
                "    mdm_lkp_accounting_units",
                "UNION ALL",
                "SELECT",
                "    '00000000'                    AS unit_code,",
                "    'حساب بنك مركزي'               AS unit_name,",
                "    NULL                           AS area_code,",
                "    'حساب بنك مركزي'               AS area_name,",
                "    NULL                           AS institution_code,",
                "    'حساب بنك مركزي'               AS institution_name,",
                "    NULL                           AS ministry_code,",
                "    'حساب بنك مركزي'               AS ministry,",
                "    NULL                           AS institutional_sector_code,",
                "    'حساب بنك مركزي'               AS institutional_sector_name,",
                "    NULL                           AS functional_sector_id,",
                "    'حساب بنك مركزي'               AS functional_sector,",
                "    NULL                           AS functional_child_id,",
                "    'حساب بنك مركزي'               AS functional_child,",
                "    'حساب بنك مركزي'               AS unit_type,",
                "    NULL                           AS governorate_id,",
                "    1                              AS is_active,",
                "    NULL                           AS unit_tsa_id,",
                "    NULL                           AS unit_gps_id,",
                "    to_date('01-JAN-2020')                  AS effective_date_from,",
                "    add_months(trunc(sysdate), 12) AS effective_date_to,",
                "    NULL                           AS source",
                "FROM",
                "    dual",
                "",
                "\")",
                "in",
                "    Source"
              ]
            }
          }
        ]
      },
      {
