          },
          {
            "type": "calculated",
            "name": "DATE_KEY",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": " FORMAT(PAYROLL_TRX[PERIOD_NAME], \"YYYYMMDD\")"
          },
          {
            "name": "PERSON_ID",
            "dataType": "double",
            "sourceColumn": "PERSON_ID"
          },
          {
            "name": "ASSIGNMENT_ID",
            "dataType": "double",
            "sourceColumn": "ASSIGNMENT_ID"
          },
          {
            "name": "ASSIGNMENT_ACTION_ID",
            "dataType": "double",
            "sourceColumn": "ASSIGNMENT_ACTION_ID"
          },
          {
            "name": "AGE",
            "dataType": "double",
            "sourceColumn": "AGE"
          },
          {
            "name": "YEARS_TO_RETIRE",
            "dataType": "double",
            "sourceColumn": "YEARS_TO_RETIRE"
          }
        ],
        "partitions": [
          {
            "name": "CURRENT_YEAR",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Value.NativeQuery(#\"Oracle/oracle-host:1521/oracle_service\", \"",
                "",
                "SELECT",
                "        det.person_id,",
                "        ded.assignment_id,",
                "        ded.payroll_id,",
                "        total_earnings,",
                "        total_deductions,",
                "        to_date('01 ' || time_period_name, 'DD MM YYYY')                                 period_name,",
                "        run_type_id,",
                "        assignment_action_id,",
                "        creation_date,",
                "        CASE",
                "            WHEN sex = 'M' THEN",
                "                'ذكر'",
                "            WHEN sex = 'F' THEN",
                "                'أنثى'",
                "            ELSE",
                "                'غير محدد'",
                "        END                                                                              gender,",
                "        floor(months_between(sysdate, date_of_birth) / 12)                               age,",
                "        abs(floor(months_between(sysdate, to_date(retirement_date, 'DD-MM-YYYY')) / 12)) AS years_to_retire,",
                "        assignment_status_type_id,",
                "        coalesce(grad_name, 'غير محدد')                                                  grade_category,",
                "        coalesce(job_name, 'غير محدد')                                                   job_category,",
                "        coalesce(employment_category, 'غير محدد')                                        employment_category,",
                "        coalesce(salary_basis_name, 'غير محدد')                                          salary_basis_category,",
                "        coalesce(asgnment_fund, 'غير محدد')                                              fund_level",
                "    FROM",
                "             gfmis_xxpay_gfn_total_earn_ded_v ded",
                "        INNER JOIN gfmis_xxpay_gfn_per_asg_det_v det ON det.assignment_id = ded.assignment_id",
                "                                                        AND det.payroll_id = ded.payroll_id",
                "    WHERE",
                "        substr(time_period_name, - 4, 4) = EXTRACT(YEAR FROM sysdate)",
                "",
                "\")",
                "in",
                "    Source"
              ]
            },
            "annotations": [
              {
                "name": "QueryEditorSerialization",
                "value": [
                  "<?xml version=\"1.0\" encoding=\"UTF-16\"?><Gemini xmlns=\"QueryEditorSerialization\"><AnnotationContent><![CDATA[<RSQueryCommandText>let",
                  "    Source = Value.NativeQuery(#\"Oracle/oracle-host:1521/oracle_service\", \"",
                  "",
                  "WITH payroll_details AS (",
                  "    SELECT",
                  "        det.person_id,",
                  "        COUNT(DISTINCT person_id)",
                  "        OVER(PARTITION BY ded.payroll_id, assignment_status_type_id)                     employee_cnt,",
                  "        ded.assignment_id,",
                  "        ded.payroll_id,",
                  "        total_earnings,",
                  "        total_deductions,",
                  "        to_date('01 ' || time_period_name, 'DD MM YYYY')                                 period_name,",
                  "        run_type_id,",
                  "        assignment_action_id,",
                  "        creation_date,",
                  "        CASE",
                  "            WHEN sex = 'M' THEN",
                  "                'ذكر'",
                  "            WHEN sex = 'F' THEN",
                  "                'أنثى'",
                  "            ELSE",
                  "                'غير محدد'",
                  "        END                                                                              gender,",
                  "        floor(months_between(sysdate, date_of_birth) / 12)                               age,",
                  "        abs(floor(months_between(sysdate, to_date(retirement_date, 'DD-MM-YYYY')) / 12)) AS years_to_retire,",
                  "        assignment_status_type_id,",
                  "        coalesce(grad_name, 'غير محدد')                                                  grade_category,",
                  "        coalesce(job_name, 'غير محدد')                                                   job_category,",
                  "        coalesce(employment_category, 'غير محدد')                                        employment_category,",
                  "        coalesce(salary_basis_name, 'غير محدد')                                          salary_basis_category,",
                  "        coalesce(asgnment_fund, 'غير محدد')                                              fund_level",
                  "    FROM",
                  "             gfmis_xxpay_gfn_total_earn_ded_v ded",
                  "        INNER JOIN gfmis_xxpay_gfn_per_asg_det_v det ON det.assignment_id = ded.assignment_id",
                  "                                                        AND det.payroll_id = ded.payroll_id",
                  "    WHERE",
                  "        substr(time_period_name, - 4, 4) = EXTRACT(YEAR FROM sysdate)",
                  "), payroll_agg AS (",
                  "    SELECT",
                  "        COUNT(DISTINCT person_id)     employee_per_payroll_count,",
                  "        MAX(employee_cnt)             employee_count,",
                  "        COUNT(DISTINCT assignment_id) assignment_count,",
                  "        ( payroll_id )                payroll_id,",
                  "        SUM(total_earnings)           total_earnings,",
                  "        SUM(total_deductions)         total_deductions,",
                  "        period_name,",
                  "        run_type_id,",
                  "        creation_date,",
                  "        gender,",
                  "        assignment_status_type_id,",
                  "        grade_category,",
                  "        job_category,",
                  "        employment_category,",
                  "        salary_basis_category,",
                  "        fund_level",
                  "    FROM",
                  "        payroll_details",
                  "    GROUP BY",
                  "        payroll_id,",
                  "        period_name,",
                  "        run_type_id,",
                  "        creation_date,",
                  "        gender,",
                  "        assignment_status_type_id,",
                  "        grade_category,",
                  "        job_category,",
                  "        employment_category,",
                  "        salary_basis_category,",
                  "        fund_level",
                  ")",
                  "SELECT",
                  "    *",
                  "FROM",
                  "    payroll_agg",
                  "WHERE 1 = 0",
                  "",
                  "\")",
                  "in",
                  "    Source</RSQueryCommandText><RSQueryCommandType>Text</RSQueryCommandType><RSQueryDesignState></RSQueryDesignState>]]></AnnotationContent></Gemini>"
                ]
              }
            ]
          },
          {
            "name": "PREVIOUS_YEAR",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Value.NativeQuery(#\"Oracle/oracle-host:1521/oracle_service\", \"",
                "",
                "SELECT",
                "    det.person_id,",
                "    ded.assignment_id,",
                "    ded.payroll_id,",
                "    total_earnings,",
                "    total_deductions,",
                "    TO_DATE('01 ' || time_period_name, 'DD MM YYYY')          period_name,",
                "    run_type_id,",
                "    assignment_action_id,",
                "    creation_date,",
                "    CASE",
                "        WHEN sex = 'M' THEN",
                "            'ذكر'",
                "        WHEN sex = 'F' THEN",
                "            'أنثى'",
                "        ELSE",
                "            'غير محدد'",
                "    END                                                       gender,",
                "    floor(months_between(sysdate, date_of_birth) / 12)        age,",
                "    abs(floor(months_between(sysdate,",
                "                             TO_DATE(retirement_date, 'DD-MM-YYYY')) / 12)) AS years_to_retire,",
                "    assignment_status_type_id,",
                "    coalesce(grad_name, 'غير محدد')                           grade_category,",
                "    coalesce(job_name, 'غير محدد')                            job_category,",
                "    coalesce(employment_category, 'غير محدد')                 employment_category,",
                "    coalesce(salary_basis_name, 'غير محدد')                   salary_basis_category,",
                "    coalesce(asgnment_fund, 'غير محدد')                       fund_level",
                "FROM",
                "         gfmis_xxpay_gfn_total_earn_ded_v ded",
                "    INNER JOIN gfmis_xxpay_gfn_per_asg_det_v det ON det.assignment_id = ded.assignment_id",
                "                                                    AND det.payroll_id = ded.payroll_id",
                "WHERE",
                "    substr(time_period_name, - 4, 4) IN (",
                "        SELECT",
                "            EXTRACT(YEAR FROM sysdate) - level AS previous_year",
                "        FROM",
                "            dual",
                "        CONNECT BY",
                "            level <= 3",
                "    )",
                "",
                "\")",
                "in",
                "    Source"
              ]
            },
            "annotations": [
              {
                "name": "QueryEditorSerialization",
                "value": [
                  "<?xml version=\"1.0\" encoding=\"UTF-16\"?><Gemini xmlns=\"QueryEditorSerialization\"><AnnotationContent><![CDATA[<RSQueryCommandText>let",
                  "    Source = Value.NativeQuery(#\"Oracle/oracle-host:1521/oracle_service\", \"",
                  "",
                  "SELECT",
                  "    det.person_id,",
                  "    ded.assignment_id,",
                  "    ded.payroll_id,",
                  "    total_earnings,",
                  "    total_deductions,",
                  "    TO_DATE('01 ' || time_period_name, 'DD MM YYYY')          period_name,",
                  "    run_type_id,",
                  "    assignment_action_id,",
                  "    creation_date,",
                  "    CASE",
                  "        WHEN sex = 'M' THEN",
                  "            'ذكر'",
                  "        WHEN sex = 'F' THEN",
                  "            'أنثى'",
                  "        ELSE",
                  "            'غير محدد'",
                  "    END                                                       gender,",
                  "    floor(months_between(sysdate, date_of_birth) / 12)        age,",
                  "    abs(floor(months_between(sysdate,",
                  "                             TO_DATE(retirement_date, 'DD-MM-YYYY')) / 12)) AS years_to_retire,",
                  "    assignment_status_type_id,",
                  "    coalesce(grad_name, 'غير محدد')                           grade_category,",
                  "    coalesce(job_name, 'غير محدد')                            job_category,",
                  "    coalesce(employment_category, 'غير محدد')                 employment_category,",
                  "    coalesce(salary_basis_name, 'غير محدد')                   salary_basis_category,",
                  "    coalesce(asgnment_fund, 'غير محدد')                       fund_level",
                  "FROM",
                  "         gfmis_xxpay_gfn_total_earn_ded_v ded",
                  "    INNER JOIN gfmis_xxpay_gfn_per_asg_det_v det ON det.assignment_id = ded.assignment_id",
                  "                                                    AND det.payroll_id = ded.payroll_id",
                  "WHERE",
                  "    substr(time_period_name, - 4, 4) IN (",
                  "        SELECT",
                  "            EXTRACT(YEAR FROM sysdate) - level AS previous_year",
                  "        FROM",
                  "            dual",
                  "        CONNECT BY",
                  "            level <= 3",
                  "    )",
                  "",
                  "\")",
                  "in",
                  "    Source</RSQueryCommandText><RSQueryCommandType>Text</RSQueryCommandType><RSQueryDesignState></RSQueryDesignState>]]></AnnotationContent></Gemini>"
                ]
              }
            ]
          }
        ],
        "measures": [
          {
            "name": "#.PAYROLL_COUNT",
            "expression": " DISTINCTCOUNT(PAYROLL_TRX[PAYROLL_ID])",
            "formatString": "#,0"
          },
          {
            "name": "#.EMPLOYEES_COUNT",
            "expression": " DISTINCTCOUNT(PAYROLL_TRX[PERSON_ID])",
            "formatString": "#,0"
          },
          {
            "name": "#.EARNINGS_AMT",
            "expression": " SUM(PAYROLL_TRX[TOTAL_EARNINGS])",
            "formatString": "#,0"
          },
          {
            "name": "#.DEDUCTIONS_AMT",
            "expression": " SUM(PAYROLL_TRX[TOTAL_DEDUCTIONS])",
            "formatString": "#,0"
          },
          {
            "name": "#.AGE_AVERAGE",
            "expression": " AVERAGE(PAYROLL_TRX[AGE])",
            "formatString": "#,0"
          },
          {
            "name": "#.YEARS_TO_RETIRE_AVERAGE",
            "expression": " AVERAGE(PAYROLL_TRX[YEARS_TO_RETIRE])",
            "formatString": "#,0"
          }
        ]
      },
