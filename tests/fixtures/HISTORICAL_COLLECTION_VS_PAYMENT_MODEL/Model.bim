            "dataType": "string",
            "sourceColumn": "INISTITBARCHNAMEARB"
          },
          {
            "type": "calculated",
            "name": "DATE_KEY_SETT",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": " FORMAT(GOV[SETTELMENT_DATE], \"YYYYMMDD\")"
          },
          {
            "name": "BUSINESS_FLAG",
            "dataType": "string",
            "sourceColumn": "BUSINESS_FLAG"
          },
          {
            "name": "IS_INTEGRATED",
            "dataType": "string",
            "sourceColumn": "IS_INTEGRATED"
          },
          {
            "name": "BUDGET_CATEGORY_CODE",
            "dataType": "string",
            "sourceColumn": "BUDGET_CATEGORY_CODE"
          },
          {
            "name": "DELIVERY_CHANNEL_TYPE_ID",
            "dataType": "double",
            "sourceColumn": "DELIVERY_CHANNEL_TYPE_ID"
          },
          {
            "name": "ISSUER_ID",
            "dataType": "double",
            "sourceColumn": "ISSUER_ID"
          },
          {
            "name": "DELIVERY_CHANNEL_ID",
            "dataType": "string",
            "sourceColumn": "DELIVERY_CHANNEL_ID"
          },
          {
            "name": "ROOT_ID",
            "dataType": "string",
            "sourceColumn": "ROOT_ID"
          },
          {
            "type": "calculated",
            "name": "CURRENCY_ID",
            "dataType": "int64",
            "isDataTypeInferred": true,
            "expression": "1"
          }
        ],
        "partitions": [
          {
            "name": "Partition",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Value.NativeQuery(#\"Oracle/oracle-host:1521/oracle_service\", \"",
                "",
                "SELECT",
                "    trx_count,",
                "    amount,",
                "    authamnt,",
                "    interchangefees,",
                "    setldate,",
                "    settelment_date,",
                "    sp_code,",
                "    inistitbarchnamearb,",
                "    fe_id,",
                "    channel_id,",
                "    merid,",
                "    'MER-' || merid root_id,",
                "    terid,",
                "    tsa_flag,",
                "    flag,",
                "    coalesce((g.au_code), to_char(aud.au_code), to_char(auda.au_code), 'MUSEUM') au_code,",
                "    coalesce(to_char(aud.au_tsa_id), to_char(auda.au_tsa_id),",
                "             CASE",
                "                 WHEN channel_id = 7",
                "                      AND flag = 'GOV' THEN",
                "                     'COMM'",
                "                 WHEN channel_id = 7",
                "                      AND flag <> 'GOV' THEN",
                "                     'MUSEUM'",
                "             END",
                "    )                                                                            au_tsa_id,",
                "    CASE",
                "        WHEN substr(sp_code, 1, 2) IN ( '87', '94' ) THEN",
                "            'GOV'",
                "        WHEN substr(sp_code, 1, 2) IN ( '89', '92' ) THEN",
                "            'ABE POST'",
                "        WHEN substr(sp_code, 1, 2) IN ( '90', '91' ) THEN",
                "            'INSURENCE'",
                "        WHEN substr(sp_code, 1, 2) IN ( '84', '78' ) THEN",
                "            'TPP'",
                "        ELSE",
                "            'COMM'",
                "    END                                                                          business_flag,",
                "    coalesce(to_char(is_integrated), 'COMM')                                     is_integrated,",
                "    CASE",
                "        WHEN is_integrated = 0",
                "             AND budget_code IS NOT NULL THEN",
                "            substr(budget_code, 3, instr(budget_code, '-', - 1, 1))",
                "            || '0'",
                "            || substr(budget_code, 1, instr(budget_code, '-', - 1, 1) - 1)",
                "        WHEN is_integrated = 1",
                "             AND budget_code = '1-2' THEN",
                "            substr(budget_code, 3, instr(budget_code, '-', - 1, 1))",
                "            || '0'",
                "            || substr(budget_code, 1, instr(budget_code, '-', - 1, 1) - 1)",
                "        WHEN budget_code IS NULL THEN",
                "            'COMM'",
                "        ELSE",
                "            budget_code",
                "    END                                                                          budget_category_code,",
                "    CASE",
                "        WHEN g.flag = 'GOV' THEN",
                "            5 -- Accounting Unit",
                "        ELSE",
                "            6 -- Merchant",
                "    END                                                                          delivery_channel_type_id,",
                "    CASE",
                "        WHEN g.flag = 'GOV' THEN",
                "            'AU-'",
                "            || coalesce(coalesce((g.au_code), to_char(aud.au_code), to_char(auda.au_code), 'MUSEUM'), br.accno, 'C00000000')",
                "        ELSE",
                "            'POS-' || g.merid",
                "    END                                                                          delivery_channel_id,",
                "    coalesce(g.issuer_id,0 ) issuer_id",
                "FROM",
                "    gov_txn_hist_agg               g",
                "    LEFT JOIN oracle_user.lkp_accounting_units aud ON substr(aud.au_code, 1, 8) = substr(g.au_code, 2, 8)",
                "                                                    AND aud.isactive = 0",
                "                                                    AND substr(g.au_code, 1, 1) = 9",
                "    LEFT JOIN oracle_user.lkp_accounting_units auda ON to_char(auda.au_code) = g.au_code",
                "                                                     AND auda.isactive = 1",
                "    LEFT JOIN sts_tblinistbranchs            br ON g.sp_code = br.inistitbarchcode",
                "",
                "\")",
                "in",
                "    Source"
              ]
            }
          }
        ],
