            "sourceColumn": "ROOT_ID"
          }
        ],
        "partitions": [
          {
            "name": "Partition",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Value.NativeQuery(#\"Oracle/oracle-host:1521/oracle_service\", \"",
                "WITH lpr AS (",
                "    SELECT DISTINCT",
                "        a.id,",
                "        b.id   partner_id,",
                "        a.name partner,",
                "        CASE",
                "            WHEN b.id = '38399' THEN",
                "                b.id",
                "            ELSE",
                "                b2.id",
                "        END    bank_id,",
                "        CASE",
                "            WHEN b.name = '38399' THEN",
                "                b.name",
                "            ELSE",
                "                b2.name",
                "        END    bank",
                "    FROM",
                "        con_fe              a",
                "        LEFT JOIN con_fe_epay_map     b ON a.id = b.u_id",
                "        LEFT JOIN account_offices_mst acof ON acof.entity_id = b.id",
                "        LEFT JOIN account_offices_dtl acdtl ON acdtl.acc_off_id = acof.acc_off_id",
                "        LEFT JOIN con_fe_epay_map     b2 ON b2.id = acdtl.rc_entity_pi_id",
                "    WHERE",
                "        lower(a.type) = 'partner'",
                ")",
                "SELECT",
                "    a.*,",
                "    'EP-' || a.sp_id as root_id,",
                "    pr.u_id               fe_id,",
                "    nvl(fe.u_id, pr.u_id) AS coll_bank_id",
                "FROM",
                "    epaysettm.epay_trx_agg a",
                "    LEFT JOIN con_fe_epay_map        pr ON a.fe_id = pr.id",
                "    LEFT JOIN lpr ON a.fe_id = lpr.partner_id",
                "    LEFT JOIN con_fe_epay_map        fe ON lpr.bank_id = fe.id",
                "",
                "\")",
                "in",
                "    Source"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "EPay_TRX_COUNT",
            "expression": " SUM(EPAY_TRX_AGG[TRXCOUNT])",
            "formatString": "#,0"
          }
        ]
      },
