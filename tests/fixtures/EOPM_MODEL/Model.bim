          },
          {
            "name": "last_refresh",
            "dataType": "dateTime",
            "sourceColumn": "last_refresh"
          }
        ],
        "partitions": [
          {
            "name": "Partition",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #date(2024, 1, 1),",
                "    Today = Date.From(DateTime.LocalNow()),",
                "    DateList = List.Dates(Source, Duration.Days(Today - Source) + 1, #duration(1,0,0,0)),",
                "    DateTable = Table.FromList(DateList, Splitter.SplitByNothing(), {\"calendar_date\"}),",
                "",
                "    // Format and enrich columns",
                "    #\"Changed Type\" = Table.TransformColumnTypes(DateTable,{{\"calendar_date\", type date}}),",
                "    #\"Added date_key\" = Table.AddColumn(#\"Changed Type\", \"date_key\", each Date.ToText([calendar_date], \"yyyyMMdd\"), type text),",
                "    #\"Added calendar_date_formatted\" = Table.AddColumn(#\"Added date_key\", \"calendar_date_formatted\", each Date.ToText([calendar_date], \"yyyy-MM-dd\"), type text),",
                "    #\"Added year\" = Table.AddColumn(#\"Added calendar_date_formatted\", \"year\", each Date.ToText([calendar_date], \"yyyy\"), type text),",
                "    #\"Added quarter\" = Table.AddColumn(#\"Added year\", \"quarter\", each Text.From(Date.QuarterOfYear([calendar_date])), type text),",
                "    #\"Added quarter_name\" = Table.AddColumn(#\"Added quarter\", \"quarter_name\", each \"Q\" & Text.From(Date.QuarterOfYear([calendar_date])), type text),",
                "    #\"Added month\" = Table.AddColumn(#\"Added quarter_name\", \"month\", each Date.Month([calendar_date]), Int64.Type),",
                "    #\"Added month_ch\" = Table.AddColumn(#\"Added month\", \"month_ch\", each Date.ToText([calendar_date], \"MM\"), type text),",
                "    #\"Added month_name\" = Table.AddColumn(#\"Added month_ch\", \"month_name\", each Text.Upper(Date.ToText([calendar_date], \"MMMM\")), type text),",
                "    #\"Added month_short_name\" = Table.AddColumn(#\"Added month_name\", \"month_short_name\", each Text.Upper(Date.ToText([calendar_date], \"MMM\")), type text),",
                "    #\"Added month_year\" = Table.AddColumn(#\"Added month_short_name\", \"month_year\", each Text.Upper(Date.ToText([calendar_date], \"MMM\")) & \"-\" & Date.ToText([calendar_date], \"yyyy\"), type text),",
                "    #\"Added week\" = Table.AddColumn(#\"Added month_year\", \"week\", each Date.ToText([calendar_date], \"ww\"), type text),",
                "    #\"Added day\" = Table.AddColumn(#\"Added week\", \"day\", each Date.ToText([calendar_date], \"dd\"), type text),",
                "    #\"Added day_name\" = Table.AddColumn(#\"Added day\", \"day_name\", each Text.Upper(Date.ToText([calendar_date], \"dddd\")), type text),",
                "    #\"Added day_short_name\" = Table.AddColumn(#\"Added day_name\", \"day_short_name\", each Text.Upper(Date.ToText([calendar_date], \"ddd\")), type text),",
                "    #\"Added start_of_month\" = Table.AddColumn(#\"Added day_short_name\", \"start_of_month\", each Date.StartOfMonth([calendar_date]), type date),",
                "    #\"Added end_of_month\" = Table.AddColumn(#\"Added start_of_month\", \"end_of_month\", each Date.EndOfMonth([calendar_date]), type date),",
                "    #\"Added start_of_quarter\" = Table.AddColumn(#\"Added end_of_month\", \"start_of_quarter\", each Date.StartOfQuarter([calendar_date]), type date),",
                "    #\"Added end_of_quarter\" = Table.AddColumn(#\"Added start_of_quarter\", \"end_of_quarter\", each Date.EndOfQuarter([calendar_date]), type date),",
                "",
                "    // Fiscal logic",
                "    #\"Added fiscal_year\" = Table.AddColumn(#\"Added end_of_quarter\", \"fiscal_year\", each if Date.Month([calendar_date]) >= 7 then Date.Year([calendar_date]) + 1 else Date.Year([calendar_date]), Int64.Type),",
                "    #\"Added fiscal_year_range\" = Table.AddColumn(#\"Added fiscal_year\", \"fiscal_year_range\", each if Date.Month([calendar_date]) >= 7 then Text.From(Date.Year([calendar_date])) & \"-\" & Text.From(Date.Year([calendar_date]) + 1) else Text.From(Date.Year([calendar_date]) - 1) & \"-\" & Text.From(Date.Year([calendar_date])), type text),",
                "    #\"Added fiscal_month\" = Table.AddColumn(#\"Added fiscal_year_range\", \"fiscal_month\", each if Date.Month([calendar_date]) >= 7 then Date.Month([calendar_date]) - 6 else Date.Month([calendar_date]) + 6, Int64.Type),",
                "",
                "    // Last refresh timestamp",
                "    #\"Added last_refresh\" = Table.AddColumn(#\"Added fiscal_month\", \"last_refresh\", each DateTime.LocalNow(), type datetime)",
                "in",
                "    #\"Added last_refresh\""
              ]
            }
          }
        ]
      },
