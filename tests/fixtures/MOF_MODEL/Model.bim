      {
        "name": "PAYROLL_LKPS",
        "columns": [
          {
            "name": "PAYROLL_ID",
            "dataType": "double",
            "sourceColumn": "PAYROLL_ID"
          },
          {
            "name": "UNIT_CODE",
            "dataType": "string",
            "sourceColumn": "UNIT_CODE"
          },
          {
            "name": "UNIT_NAME",
            "dataType": "string",
            "sourceColumn": "UNIT_NAME"
          },
          {
            "name": "AREA_CODE",
            "dataType": "string",
            "sourceColumn": "AREA_CODE"
          },
          {
            "name": "AREA_NAME",
            "dataType": "string",
            "sourceColumn": "AREA_NAME"
          },
          {
            "name": "UNIT_TYPE",
            "dataType": "string",
            "sourceColumn": "UNIT_TYPE"
          },
          {
            "name": "FUNCTIONAL_SECTOR_CODE",
            "dataType": "string",
            "sourceColumn": "FUNCTIONAL_SECTOR_CODE"
          },
          {
            "name": "FUNCTIONAL_SECTOR",
            "dataType": "string",
            "sourceColumn": "FUNCTIONAL_SECTOR"
