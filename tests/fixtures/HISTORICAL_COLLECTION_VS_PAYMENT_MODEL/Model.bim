            "sourceColumn": "ACCOUNT_NUMBER"
          },
          {
            "name": "ACCOUNT_NAME",
            "dataType": "string",
            "sourceColumn": "ACCOUNT_NAME"
          },
          {
            "name": "ACCOUNT_TYPE",
            "dataType": "string",
            "sourceColumn": "ACCOUNT_TYPE"
          },
          {
            "name": "IS_COMMERCIAL",
            "dataType": "double",
            "sourceColumn": "IS_COMMERCIAL"
          },
          {
            "name": "UNIT_CODE",
            "dataType": "string",
            "sourceColumn": "UNIT_CODE"
          },
          {
            "name": "IS_ACTIVE",
            "dataType": "string",
            "sourceColumn": "IS_ACTIVE"
          },
          {
            "type": "calculated",
            "name": "SERVICE_ID",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": " SERVICES[ENTITY_ID] & \"-\" & SERVICES[ACC_OFF_DTL_ID]"
          }
        ],
        "partitions": [
          {
            "name": "Partition",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Value.NativeQuery(#\"Oracle/oracle-host:1521/oracle_service\", \"",
                "",
                "WITH ent AS (",
                "    SELECT",
                "        en.ent_id,",
                "        en.entity_type_id,",
                "        en.ent_code,",
                "        enl.ent_name",
                "    FROM",
                "        epay_entity_mst      en",
                "        LEFT JOIN epay_entity_mst_lang enl ON en.ent_id = enl.ent_id",
                "                                              AND enl.lang_id = 2",
                ")",
                "    SELECT",
                "        *",
                "    FROM",
                "        (",
                "            SELECT DISTINCT",
                "                aom.entity_id,",
                "                sp.ent_code                                                        entity_code,",
                "                sp.ent_name                                                        entity_name,",
                "                aom.entity_type_id,",
                "                et.type_name                                                       entity_type,",
                "                aod.rc_entity_pi_id,",
                "                enlpi.ent_code                                                     rc_entity_pi_code,",
                "                enlpi.ent_name                                                     rc_entity_pi_name,",
                "                aod.stm_entity_pi_id,",
                "                enlst.ent_code                                                     stm_entity_pi_code,",
                "                enlst.ent_name                                                     stm_entity_pi_name,",
                "                aod.rc_acc_no,",
                "                aod.stm_acc_no,",
                "                aod.acc_off_id,",
                "                aoml.acc_off_name,",
                "                aod.acc_off_dtl_code                                               acc_off_dtl_id,",
                "                aodl.acc_off_dtl_name,",
                "                coalesce(to_char(tsa.account_number), to_char(cbe.account_number)) account_number,",
                "                coalesce(to_char(tsa.account_name), to_char(cbe.account_name))     account_name,",
                "                coalesce(to_char(tsa.account_type), to_char(cbe.account_type))     account_type,",
                "                CASE",
                "                    WHEN coalesce(to_char(tsa.account_type), to_char(cbe.account_type)) IS NOT NULL THEN",
                "                        0",
                "                    ELSE",
                "                        1",
                "                END                                                                is_commercial,",
                "                coalesce(to_char(tsa.unit_code), to_char(cbe.unit_code))           unit_code,",
                "                coalesce(to_char(tsa.is_active), to_char(cbe.is_active))           is_active",
                "            FROM",
                "                account_offices_mst      aom",
                "                LEFT JOIN account_offices_mst_lang aoml ON aoml.acc_off_id = aom.acc_off_id",
                "                                                           AND aoml.lang_id = 2",
                "                LEFT JOIN ent                      sp ON sp.ent_id = aom.entity_id",
                "                LEFT JOIN entity_types_lang        et ON et.entity_type_id = aom.entity_type_id",
                "                                                  AND et.lang_id = 2",
                "                INNER JOIN account_offices_dtl      aod ON aod.acc_off_id = aom.acc_off_id",
                "                LEFT JOIN account_offices_dtl_lang aodl ON aodl.acc_off_dtl_id = aod.acc_off_dtl_code",
                "                                                           AND aodl.lang_id = 2",
                "                LEFT JOIN ent                      enlpi ON enlpi.ent_id = aod.rc_entity_pi_id",
                "                LEFT JOIN ent                      enlst ON enlst.ent_id = aod.stm_entity_pi_id",
                "                LEFT JOIN mdm_lkp_tsa_accounts     tsa ON substr(tsa.account_number, 3) = substr(aod.rc_acc_no, 4)",
                "                LEFT JOIN mdm_lkp_cbe_accounts     cbe ON cbe.account_number = aod.rc_acc_no",
                "        )",
                "\")",
                "in",
                "    Source"
              ]
            }
          }
        ]
      },
