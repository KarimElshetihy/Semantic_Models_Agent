            "dataType": "string",
            "sourceColumn": "INSTITUTIONAL_SECTOR_CODE"
          },
          {
            "name": "INSTITUTIONAL_SECTOR",
            "dataType": "string",
            "sourceColumn": "INSTITUTIONAL_SECTOR"
          },
          {
            "name": "IS_MINISTRY",
            "dataType": "double",
            "sourceColumn": "IS_MINISTRY"
          },
          {
            "name": "GOVERNORATE_ID",
            "dataType": "double",
            "sourceColumn": "GOVERNORATE_ID"
          },
          {
            "name": "GOVERNORATE_NAME_AR",
            "dataType": "string",
            "sourceColumn": "GOVERNORATE_NAME_AR"
          },
          {
            "name": "GOVERNORATE_NAME_EN",
            "dataType": "string",
            "sourceColumn": "GOVERNORATE_NAME_EN"
          },
          {
            "name": "LAT",
            "dataType": "double",
            "sourceColumn": "LAT"
          },
          {
            "name": "LNG",
            "dataType": "double",
            "sourceColumn": "LNG"
          },
          {
            "name": "INSTITUTION_CODE",
            "dataType": "string",
            "sourceColumn": "INSTITUTION_CODE"
          }
        ],
        "partitions": [
          {
            "name": "Partition",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Value.NativeQuery(#\"Oracle/oracle-host:1521/oracle_service\", \"",
                "",
                "WITH lkp_attributes AS (",
                "    SELECT",
                "        payroll_id,",
                "        segment2                      unit_code,",
                "        descr_segment2                unit_name,",
                "        code_bu                       area_code,",
                "        descr_bu                      area_name,",
                "        budget_type                   unit_type,",
                "        coalesce(code_attr1, '00000') functional_sector_code,",
                "        coalesce(descr_attr1, 'أخرى') functional_sector,",
                "        coalesce(code_attr2, '0000')  institutional_sector_code,",
                "        coalesce(descr_attr2, 'أخرى') institutional_sector,",
                "        CASE",
                "            WHEN code_attr2 IS NOT NULL THEN",
                "                1",
                "            ELSE",
                "                0",
                "        END                           is_ministry,",
                "        descr_attr9                   governorate,",
                "        CASE",
                "            WHEN descr_attr9 = 'القاهرة'       THEN",
                "                1",
                "            WHEN descr_attr9 = 'الجيزة'        THEN",
                "                2",
                "            WHEN descr_attr9 = 'الإسكندرية'    THEN",
                "                3",
                "            WHEN descr_attr9 = 'الدقهلية'      THEN",
                "                4",
                "            WHEN descr_attr9 = 'البحر الأحمر'  THEN",
                "                5",
                "            WHEN descr_attr9 = 'البحيرة'       THEN",
                "                6",
                "            WHEN descr_attr9 = 'الفيوم'        THEN",
                "                7",
                "            WHEN descr_attr9 = 'الغربية'       THEN",
                "                8",
                "            WHEN descr_attr9 = 'الإسماعيلية'   THEN",
                "                9",
                "            WHEN descr_attr9 = 'المنوفية'      THEN",
                "                10",
                "            WHEN descr_attr9 = 'المنيا'        THEN",
                "                11",
                "            WHEN descr_attr9 = 'القليوبية'     THEN",
                "                12",
                "            WHEN descr_attr9 = 'الوادي الجديد' THEN",
                "                13",
                "            WHEN descr_attr9 = 'السويس'        THEN",
                "                14",
                "            WHEN descr_attr9 = 'أسوان'         THEN",
                "                15",
                "            WHEN descr_attr9 = 'أسيوط'         THEN",
                "                16",
                "            WHEN descr_attr9 = 'بني سويف'      THEN",
                "                17",
                "            WHEN descr_attr9 = 'بورسعيد'       THEN",
                "                18",
                "            WHEN descr_attr9 = 'دمياط'         THEN",
                "                19",
                "            WHEN descr_attr9 = 'الشرقية'       THEN",
                "                20",
                "            WHEN descr_attr9 = 'جنوب سيناء'    THEN",
                "                21",
                "            WHEN descr_attr9 = 'كفر الشيخ'     THEN",
                "                22",
                "            WHEN descr_attr9 = 'مطروح'         THEN",
                "                23",
                "            WHEN descr_attr9 = 'الاقصر'        THEN",
                "                24",
                "            WHEN descr_attr9 = 'قنا'           THEN",
                "                25",
                "            WHEN descr_attr9 = 'شمال سيناء'    THEN",
                "                26",
                "            WHEN descr_attr9 = 'سوهاج'         THEN",
                "                27",
                "            ELSE",
                "                0",
                "        END                           AS governorate_id,",
                "        code_attr9                    governorate_code",
                "    FROM",
                "        gfmis_xxpay_gfn_attributes_v",
                "), lkps_details AS (",
                "    SELECT",
                "        a.payroll_id,",
                "        a.unit_code,",
                "        a.unit_name,",
                "        a.area_code,",
                "        a.area_name,",
                "        substr(a.unit_code,1,3)||'00000' institution_code,",
                "        a.unit_type,",
                "        a.functional_sector_code,",
                "        a.functional_sector,",
                "        a.institutional_sector_code,",
                "        a.institutional_sector,",
                "        a.is_ministry,",
                "        a.governorate_id,",
                "        coalesce(governorate_name_ar, 'أخرى')  governorate_name_ar,",
                "        coalesce(governorate_name_en, 'Other') governorate_name_en,",
                "        lat,",
                "        lng",
                "    FROM",
                "        lkp_attributes     a",
                "        LEFT JOIN egypt_governorates g ON a.governorate_id = g.governorate_id",
                ")",
                "SELECT",
                "    *",
                "FROM",
                "    lkps_details",
                "",
                "\")",
                "in",
                "    Source"
              ]
            }
          }
        ]
      },
      {
        "name": "PAYROLL_TRX",
        "columns": [
          {
            "name": "PAYROLL_ID",
            "dataType": "double",
