          },
          {
            "name": "ACCOUNT_NUMBER",
            "dataType": "string",
            "sourceColumn": "ACCOUNT_NUMBER"
          },
          {
            "name": "TASK_ID",
            "dataType": "string",
            "sourceColumn": "TASK_ID"
          },
          {
            "name": "TASK_NUMBER",
            "dataType": "string",
            "sourceColumn": "TASK_NUMBER"
          },
          {
            "name": "LOB_CODE",
            "dataType": "string",
            "sourceColumn": "LOB_CODE"
          },
          {
            "name": "BUSINESS_UNIT_ID",
            "dataType": "string",
            "sourceColumn": "BUSINESS_UNIT_ID"
          },
          {
            "type": "calculated",
            "name": "DATE_KEY",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": " FORMAT(TRX_INVOICES[TRX_DATE], \"YYYYMMDD\")"
          }
        ],
        "partitions": [
          {
            "name": "Partition",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Value.NativeQuery(#\"Oracle/oracle-host:1521/oracle_service\", \"",
                "",
                "SELECT",
                "    COUNT(invoice_number)                            invoice_count,",
                "    coalesce(SUM(invoice_amount), 0)                 collected_amount,",
                "    coalesce(SUM(revenue_amount), 0)                 due_amount,",
                "    coalesce(LEAD(SUM(invoice_amount))",
                "             OVER(PARTITION BY coalesce(invoice_type, 'STANDARD'), prj.customer_id, inv.contract_id, inv.contract_number, inv.project_id,",
                "     inv.project_number, prj.account_id, prj.account_number, task_id, task_number,",
                "     inv.lob_code, prj.business_unit_id",
                "                  ORDER BY",
                "                      trunc(coalesce(invoice_date, revenue_date), 'Q')",
                "    ), 0) - SUM(revenue_amount)                      accrued_amount,",
                "    trunc(coalesce(invoice_date, revenue_date), 'Q') trx_date,",
                "    coalesce(invoice_type, 'STANDARD')               invoice_type,",
                "    prj.customer_id,",
                "    inv.contract_id,",
                "    inv.contract_number,",
                "    inv.project_id,",
                "    inv.project_number,",
                "    prj.account_id,",
                "    prj.account_number,",
                "    task_id,",
                "    task_number,",
                "    inv.lob_code,",
                "    prj.business_unit_id",
                "FROM",
                "    erp_contract_invoice_collection inv",
                "    LEFT JOIN erp_project_contract_map        prj ON prj.contract_id = inv.contract_id",
                "                                              AND prj.project_id = inv.project_id",
                "                                              AND prj.lob_code = inv.lob_code",
                "WHERE",
                "--            inv.project_name LIKE '%6.1. Hyperion%' AND",
                "        coalesce(invoice_date, revenue_date) >= '01-JAN-2024'",
                "    AND coalesce(invoice_date, revenue_date) <= '31-OCT-2026'",
                "    and invoice_type <> 'CANCEL'",
                "GROUP BY",
                "    trunc(coalesce(invoice_date, revenue_date), 'Q'),",
                "    coalesce(invoice_type, 'STANDARD'),",
                "    prj.customer_id,",
                "    inv.contract_id,",
                "    inv.contract_number,",
                "    inv.project_id,",
                "    inv.project_number,",
                "    prj.account_id,",
                "    prj.account_number,",
                "    task_id,",
                "    task_number,",
                "    inv.lob_code,",
                "    prj.business_unit_id",
                "ORDER BY",
                "    trx_date",
                "",
                "\")",
                "in",
                "    Source"
              ]
            }
          }
        ]
      },
