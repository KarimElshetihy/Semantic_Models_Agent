      {
        "name": "SERVICE_PROVIDERS",
        "columns": [
          {
            "name": "SP_ID",
            "dataType": "string",
            "sourceColumn": "SP_ID"
          },
          {
            "name": "SERVICE_PROVIDER",
            "dataType": "string",
            "sourceColumn": "SERVICE_PROVIDER"
          },
          {
            "name": "SERVICE_PROVIDER_AR",
            "dataType": "string",
            "sourceColumn": "SERVICE_PROVIDER_AR"
          },
          {
            "name": "GROUP_NAME",
            "dataType": "string",
            "sourceColumn": "GROUP_NAME"
          },
          {
            "name": "GROUP_NAME_AR",
            "dataType": "string",
            "sourceColumn": "GROUP_NAME_AR"
          }
        ],
        "partitions": [
          {
            "name": "Partition",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Value.NativeQuery(#\"Oracle/oracle-host:1521/oracle_service\", \"",
                "",
                "SELECT distinct",
                "    to_char(sp.sp_id)               sp_id,",
                "    to_char(service_provider)    service_provider,",
                "    to_char(service_provider_ar) service_provider_ar,",
                "    group_name,",
                "    group_name_ar",
                "FROM",
                "    lkp_service_provider       sp",
                "    LEFT JOIN lkp_service_provider_group spg ON sp.sp_group_id = spg.id",
                "",
                "    ",
                "-------------------------------------------------",
                "UNION ALL",
                "-------------------------------------------------",
                "SELECT distinct",
                "    to_char(a.inistitbarchcode),",
                "    to_char(trim(a.inistitbarchname)),",
                "    to_char(trim(a.inistitbarchnamearb)),",
                "    CASE WHEN x.inistitbarchcode is not null THEN 'Customs Authority' ELSE  'STS' END,",
                "    CASE WHEN x.inistitbarchcode is not null THEN 'مصلحة الجمارك المصرية' ELSE  'STS' END",
                "    ",
                "FROM",
                "    sts_tblinistbranchs a left join (SELECT a.inistitbarchcode FROM sts_tblinistbranchs a inner join sts_tblinistitution b on a.inistitcode = b.inistitcode",
                "    where b.id = 87)x on a.inistitbarchcode = x.inistitbarchcode",
                "\")",
                "in",
                "    Source"
              ]
            },
            "annotations": [
              {
                "name": "QueryEditorSerialization",
                "value": [
                  "<?xml version=\"1.0\" encoding=\"UTF-16\"?><Gemini xmlns=\"QueryEditorSerialization\"><AnnotationContent><![CDATA[<RSQueryCommandText>let",
                  "    Source = Value.NativeQuery(#\"Oracle/oracle-host:1521/oracle_service\", \"",
                  "",
                  "SELECT distinct",
                  "    to_char(sp.sp_id)               sp_id,",
                  "    to_char(service_provider)    service_provider,",
                  "    to_char(service_provider_ar) service_provider_ar,",
                  "    group_name",
                  "FROM",
                  "    lkp_service_provider       sp",
                  "    LEFT JOIN lkp_service_provider_group spg ON sp.sp_group_id = spg.id",
                  "",
                  "    ",
                  "-------------------------------------------------",
                  "UNION ALL",
                  "-------------------------------------------------",
                  "SELECT distinct",
                  "    to_char(a.inistitbarchcode),",
                  "    to_char(trim(a.inistitbarchname)),",
                  "    to_char(trim(a.inistitbarchnamearb)),",
                  "    CASE WHEN x.inistitbarchcode is not null THEN 'Customs Authority' ELSE  'STS' END",
                  "FROM",
                  "    sts_tblinistbranchs a left join (SELECT a.inistitbarchcode FROM sts_tblinistbranchs a inner join sts_tblinistitution b on a.inistitcode = b.inistitcode",
                  "    where b.id = 87)x on a.inistitbarchcode = x.inistitbarchcode",
                  "",
                  "\")",
                  "in",
                  "    Source</RSQueryCommandText><RSQueryCommandType>Text</RSQueryCommandType><RSQueryDesignState></RSQueryDesignState>]]></AnnotationContent></Gemini>"
                ]
              }
            ]
          }
        ]
      },
