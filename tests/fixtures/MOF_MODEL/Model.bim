            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"DateTimeCustom\"><DateTimes><DateTime LCID=\"1033\" Group=\"GeneralLongDateTime\" FormatString=\"MM/dd/yyyy hh:mm:ss tt\" /></DateTimes></Format>"
              }
            ]
          }
        ],
        "partitions": [
          {
            "name": "CURRENT_YEAR",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Value.NativeQuery(#\"Oracle/oracle-host:1521/oracle_service\", \"",
                "",
                "SELECT",
                "    ledger_id,",
                "    actual_flag,",
                "    fund_code,",
                "    unit_code,",
                "    budget_category_code,",
                "    budget_id,",
                "    amount,",
                "    alrabt_alasly,",
                "    alrabt_almo3adal,",
                "    fe3lyat,",
                "    balancing_or_economic,",
                "    period_name",
                "FROM",
                "    gfmis_aeu_balances",
                "WHERE",
                "    (",
                "        SELECT",
                "            CASE",
                "                WHEN to_char(period_name, 'MM') < '07' THEN",
                "                    to_char(period_name, 'YYYY')",
                "                ELSE",
                "                    to_char(add_months(period_name, 6), 'YYYY')",
                "            END",
                "        FROM",
                "            dual",
                "    ) = (",
                "        SELECT",
                "            CASE",
                "                WHEN to_char(sysdate, 'MM') < '07' THEN",
                "                    to_char(sysdate, 'YYYY')",
                "                ELSE",
                "                    to_char(add_months(sysdate, 6), 'YYYY')",
                "            END",
                "        FROM",
                "            dual",
                "    )",
                "",
                "\")",
                "in",
                "    Source"
              ]
            },
            "annotations": [
              {
                "name": "QueryEditorSerialization",
                "value": [
                  "<?xml version=\"1.0\" encoding=\"UTF-16\"?><Gemini xmlns=\"QueryEditorSerialization\"><AnnotationContent><![CDATA[<RSQueryCommandText>let",
                  "    Source = Value.NativeQuery(#\"Oracle/oracle-host:1521/oracle_service\", \"",
                  "",
                  "SELECT",
                  " ledger_id,",
                  "    actual_flag,",
                  "    fund_code,",
                  "    unit_code,",
                  "    budget_category_code,",
                  "    budget_id,",
                  "    amount,",
                  "    alrabt_alasly,",
                  "    alrabt_almo3adal,",
                  "    fe3lyat,",
                  "    balancing_or_economic,",
                  "    period_name",
                  "FROM gfmis_aeu_balances",
                  "WHERE EXTRACT(YEAR FROM period_name) =",
                  "  (SELECT",
                  "    CASE",
                  "      WHEN TO_CHAR(sysdate, 'MM') < '07'",
                  "      THEN TO_CHAR(sysdate, 'YYYY')",
                  "      ELSE TO_CHAR(add_months(sysdate, 6), 'YYYY')",
                  "    END",
                  "  FROM dual",
                  "  )",
                  "",
                  "\")",
                  "in",
                  "    Source</RSQueryCommandText><RSQueryCommandType>Text</RSQueryCommandType><RSQueryDesignState></RSQueryDesignState>]]></AnnotationContent></Gemini>"
                ]
              }
            ]
          },
          {
            "name": "PREVIOUS_YEARS",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Value.NativeQuery(#\"Oracle/oracle-host:1521/oracle_service\", \"",
                "",
                "SELECT",
                "    ledger_id,",
                "    actual_flag,",
                "    fund_code,",
                "    unit_code,",
                "    budget_category_code,",
                "    budget_id,",
                "    amount,",
                "    alrabt_alasly,",
                "    alrabt_almo3adal,",
                "    fe3lyat,",
                "    balancing_or_economic,",
                "    period_name",
                "FROM",
                "    gfmis_aeu_balances",
                "WHERE",
                "    (",
                "        SELECT",
                "            CASE",
                "                WHEN to_char(period_name, 'MM') < '07' THEN",
                "                    to_char(period_name, 'YYYY')",
                "                ELSE",
                "                    to_char(add_months(period_name, 6), 'YYYY')",
                "            END",
                "        FROM",
                "            dual",
                "    ) < (",
                "        SELECT",
                "            CASE",
                "                WHEN to_char(sysdate, 'MM') < '07' THEN",
                "                    to_char(sysdate, 'YYYY')",
                "                ELSE",
                "                    to_char(add_months(sysdate, 6), 'YYYY')",
                "            END",
                "        FROM",
                "            dual",
                "    )",
                "",
                "\")",
                "in",
                "    Source"
              ]
            },
            "annotations": [
              {
                "name": "QueryEditorSerialization",
                "value": [
                  "<?xml version=\"1.0\" encoding=\"UTF-16\"?><Gemini xmlns=\"QueryEditorSerialization\"><AnnotationContent><![CDATA[<RSQueryCommandText>let",
                  "    Source = Value.NativeQuery(#\"Oracle/oracle-host:1521/oracle_service\", \"",
                  "",
                  "SELECT",
                  "    ledger_id,",
                  "    actual_flag,",
                  "    fund_code,",
                  "    unit_code,",
                  "    budget_category_code,",
                  "    budget_id,",
                  "    amount,",
                  "    alrabt_alasly,",
                  "    alrabt_almo3adal,",
                  "    fe3lyat,",
                  "    balancing_or_economic,",
                  "    period_name",
                  "FROM",
                  "    gfmis_aeu_balances",
                  "WHERE",
                  "    (",
                  "        SELECT",
                  "            CASE",
                  "                WHEN to_char(period_name, 'MM') < '07' THEN",
                  "                    to_char(period_name, 'YYYY')",
                  "                ELSE",
                  "                    to_char(add_months(period_name, 6), 'YYYY')",
                  "            END",
                  "        FROM",
                  "            dual",
                  "    ) < (",
                  "        SELECT",
                  "            CASE",
                  "                WHEN to_char(sysdate, 'MM') < '07' THEN",
                  "                    to_char(sysdate, 'YYYY')",
                  "                ELSE",
                  "                    to_char(add_months(sysdate, 6), 'YYYY')",
                  "            END",
                  "        FROM",
                  "            dual",
                  "    )",
                  "",
                  "\")",
                  "in",
                  "    Source</RSQueryCommandText><RSQueryCommandType>Text</RSQueryCommandType><RSQueryDesignState></RSQueryDesignState>]]></AnnotationContent></Gemini>"
                ]
              }
            ]
          }
        ],
        "measures": [
          {
            "name": "01.RABT_ASLY",
            "expression": [
              " ",
              "CALCULATE(",
              "\t     ABS(SUM(GFMIS[ALRABT_ALASLY])),",
              "\t     FILTER(",
              "\t                 ALL(DIM_DATE),",
              "\t\t DIM_DATE[FISCAL_YEAR_RANGE] = MAX(DIM_DATE[FISCAL_YEAR_RANGE]) &&",
              "\t\t DIM_DATE[DATE_KEY] <= MAX(DIM_DATE[DATE_KEY])",
              "\t\t ),",
              "                     DATESBETWEEN(GFMIS[PERIOD_NAME], MIN('UNITS HIERARCHY'[EFFECTIVE_DATE_FROM]), MAX('UNITS HIERARCHY'[EFFECTIVE_DATE_TO]))",
              "\t)"
            ],
            "formatString": "#,0"
          },
          {
            "name": "02.RABT_MO3ADAL",
            "expression": [
              " ",
              "CALCULATE(",
              "\t     ABS(SUM(GFMIS[ALRABT_ALMO3ADAL])),",
              "\t     FILTER(",
              "\t                 ALL(DIM_DATE),",
              "\t\t DIM_DATE[FISCAL_YEAR_RANGE] = MAX(DIM_DATE[FISCAL_YEAR_RANGE]) &&",
              "\t\t DIM_DATE[DATE_KEY] <= MAX(DIM_DATE[DATE_KEY])",
              "\t\t ),",
              "                     DATESBETWEEN(GFMIS[PERIOD_NAME], MIN('UNITS HIERARCHY'[EFFECTIVE_DATE_FROM]), MAX('UNITS HIERARCHY'[EFFECTIVE_DATE_TO]))",
              "\t)"
            ],
            "formatString": "#,0"
          },
          {
            "name": "03.FE3LYAT",
            "expression": [
              "",
              "CALCULATE(",
              "\t     ABS(SUM(GFMIS[FE3LYAT])),",
              "\t     FILTER(",
              "\t                 ALL(DIM_DATE),",
              "\t\t DIM_DATE[FISCAL_YEAR_RANGE] = MAX(DIM_DATE[FISCAL_YEAR_RANGE]) &&",
              "\t\t DIM_DATE[DATE_KEY] <= MAX(DIM_DATE[DATE_KEY])",
              "\t\t ),",
              "                     DATESBETWEEN(GFMIS[PERIOD_NAME], MIN('UNITS HIERARCHY'[EFFECTIVE_DATE_FROM]), MAX('UNITS HIERARCHY'[EFFECTIVE_DATE_TO]))",
              "\t)"
            ],
            "formatString": "#,0"
          },
          {
            "name": "03.FE3LYAT_TO_MO3ADAL",
            "expression": " DIVIDE([03.FE3LYAT],[02.RABT_MO3ADAL],0)",
            "formatString": "#,0.0%;-#,0.0%;#,0.0%"
          },
          {
            "name": "FISCAL_YEAR",
            "expression": " \"20\" & INT(RIGHT(MAX(GFMIS[PERIOD_NAME]),2)) -1 & \" - \" & \"20\" & INT(RIGHT(MAX(GFMIS[PERIOD_NAME]),2))"
          },
          {
            "name": "04.TA3DILAT",
            "expression": " [02.RABT_MO3ADAL] - [01.RABT_ASLY]",
            "formatString": "#,0.00"
          },
          {
            "name": "04.TA3DILAT_TO_ASLY",
            "expression": " DIVIDE([04.TA3DILAT],[01.RABT_ASLY],0)",
            "formatString": "#,0.0%;-#,0.0%;#,0.0%"
          },
          {
            "name": "05.E3TEMADAT_REMAINING",
            "expression": " [02.RABT_MO3ADAL] - [03.FE3LYAT]",
            "formatString": "#,0.00"
          },
          {
            "name": "05.E3TEMADAT",
            "expression": " [03.FE3LYAT]- [02.RABT_MO3ADAL]",
            "formatString": "#,0.00"
          },
          {
            "name": "05.TANFIZ_PERCENTAGE",
            "expression": " DIVIDE([03.FE3LYAT],[02.RABT_MO3ADAL],0)",
            "formatString": "#,0.0%;-#,0.0%;#,0.0%"
          },
          {
            "name": "01.RABT_ASLY_FORMATTED",
            "expression": [
              " ",
              "VAR VALUE_ = [01.RABT_ASLY] ",
              " ",
              "RETURN",
              " ",
              "SWITCH(",
              "        TRUE(),",
              "        ABS(Value_) < 1000, FORMAT(Value_, \"#,##0.00\"),",
              "        ABS(Value_) >= 1000 && ABS(Value_) < 1000000, FORMAT(Value_ / 1000, \"#,##0.00\") & \" K\",",
              "        ABS(Value_) >= 1000000 && ABS(Value_) < 1000000000, FORMAT(Value_ / 1000000, \"#,##0.00\") & \" M\",",
              "        ABS(Value_) >= 1000000000, FORMAT(Value_ / 1000000000, \"#,##0.00\") & \" B\"",
              "    )"
            ]
          },
          {
            "name": "02.RABT_MO3ADAL_FORMATTED",
            "expression": [
              " ",
              "VAR VALUE_ = [02.RABT_MO3ADAL]",
              " ",
              "RETURN",
              " ",
              "SWITCH(",
              "        TRUE(),",
              "        ABS(Value_) < 1000, FORMAT(Value_, \"#,##0.00\"),",
              "        ABS(Value_) >= 1000 && ABS(Value_) < 1000000, FORMAT(Value_ / 1000, \"#,##0.00\") & \" K\",",
              "        ABS(Value_) >= 1000000 && ABS(Value_) < 1000000000, FORMAT(Value_ / 1000000, \"#,##0.00\") & \" M\",",
              "        ABS(Value_) >= 1000000000, FORMAT(Value_ / 1000000000, \"#,##0.00\") & \" B\"",
              "    )"
            ]
          },
          {
            "name": "03.FE3LYAT_FORMATTED",
            "expression": [
              " ",
              "VAR VALUE_ = [03.FE3LYAT]",
              " ",
              "RETURN",
              " ",
              "SWITCH(",
              "        TRUE(),",
              "        ABS(Value_) < 1000, FORMAT(Value_, \"#,##0.00\"),",
              "        ABS(Value_) >= 1000 && ABS(Value_) < 1000000, FORMAT(Value_ / 1000, \"#,##0.00\") & \" K\",",
              "        ABS(Value_) >= 1000000 && ABS(Value_) < 1000000000, FORMAT(Value_ / 1000000, \"#,##0.00\") & \" M\",",
              "        ABS(Value_) >= 1000000000, FORMAT(Value_ / 1000000000, \"#,##0.00\") & \" B\"",
              "    )"
            ]
          },
          {
            "name": "aslyformated2",
            "expression": [
              "",
              "VAR Value_ = [01.RABT_ASLY]",
              " ",
              "RETURN",
              "SWITCH(",
              "    TRUE(),",
              "    ABS(Value_) < 1000, FORMAT(Value_, \"#,##0.00\"),",
              "    ABS(Value_) >= 1000 && ABS(Value_) < 1000000, FORMAT(Value_ / 1000, \"#,##0\") & \" K\",",
              "    ABS(Value_) >= 1000000 && ABS(Value_) < 1000000000, FORMAT(Value_ / 1000000, \"#,##0\") & \" M\",",
              "    ABS(Value_) >= 1000000000, FORMAT(Value_ / 1000000000, \"#,##0\") & \" B\"",
              ")"
            ]
          },
          {
            "name": "mo3dlformated2",
            "expression": [
              "",
              "VAR Value_ = [02.RABT_MO3ADAL]",
              " ",
              "RETURN",
              "SWITCH(",
              "    TRUE(),",
              "    ABS(Value_) < 1000, FORMAT(Value_, \"#,##0.00\"),",
              "    ABS(Value_) >= 1000 && ABS(Value_) < 1000000, FORMAT(Value_ / 1000, \"#,##0\") & \" K\",",
              "    ABS(Value_) >= 1000000 && ABS(Value_) < 1000000000, FORMAT(Value_ / 1000000, \"#,##0\") & \" M\",",
              "    ABS(Value_) >= 1000000000, FORMAT(Value_ / 1000000000, \"#,##0\") & \" B\"",
              ")"
            ]
