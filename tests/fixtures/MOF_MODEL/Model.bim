        "partitions": [
          {
            "name": "Partition",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Value.NativeQuery(#\"Oracle/oracle-host:1521/oracle_service\", \"",
                "",
                "SELECT",
                "        au.*,",
                "        CASE",
                "            WHEN institution_name = 'محافظة القاهرة'       THEN",
                "                1",
                "            WHEN institution_name = 'محافظة الجيزة'        THEN",
                "                2",
                "            WHEN institution_name = 'محافظة الإسكندرية'    THEN",
                "                3",
                "            WHEN institution_name = 'محافظة الدقهلية'      THEN",
                "                4",
                "            WHEN institution_name = 'محافظة البحر الأحمر'  THEN",
                "                5",
                "            WHEN institution_name = 'محافظة البحيرة'       THEN",
                "                6",
                "            WHEN institution_name = 'محافظة الفيوم'        THEN",
                "                7",
                "            WHEN institution_name = 'محافظة الغربية'       THEN",
                "                8",
                "            WHEN institution_name = 'محافظة الاسماعيلية'   THEN",
                "                9",
                "            WHEN institution_name = 'محافظة المنوفية'      THEN",
                "                10",
                "            WHEN institution_name = 'محافظة المنيا'        THEN",
                "                11",
                "            WHEN institution_name = 'محافظة القليوبية'     THEN",
                "                12",
                "            WHEN institution_name = 'محافظة الوادى الجديد' THEN",
                "                13",
                "            WHEN institution_name = 'محافظة السويس'        THEN",
                "                14",
                "            WHEN institution_name = 'محافظة أسوان'         THEN",
                "                15",
                "            WHEN institution_name = 'محافظة اسيوط'         THEN",
                "                16",
                "            WHEN institution_name = 'محافظة بنى سويف'      THEN",
                "                17",
                "            WHEN institution_name = 'محافظة بورسعيد'       THEN",
                "                18",
                "            WHEN institution_name = 'محافظة دمياط'         THEN",
                "                19",
                "            WHEN institution_name = 'محافظة الشرقية'       THEN",
                "                20",
                "            WHEN institution_name = 'محافظة جنوب سيناء'    THEN",
                "                21",
                "            WHEN institution_name = 'محافظة كفر الشيخ'     THEN",
                "                22",
                "            WHEN institution_name = 'محافظة مطروح'         THEN",
                "                23",
                "            WHEN institution_name = 'محافظة الأقصر'        THEN",
                "                24",
                "            WHEN institution_name = 'محافظة قنا'           THEN",
                "                25",
                "            WHEN institution_name = 'محافظة شمال سيناء'    THEN",
                "                26",
                "            WHEN institution_name = 'محافظة سوهاج'         THEN",
                "                27",
                "            ELSE",
                "                NULL",
                "        END AS governorate_id",
                "    FROM",
                "        gfmis_au_hierarchy_master au",
                "    ",
                "\")",
                "in",
                "    Source"
              ]
            }
          }
        ]
      },
