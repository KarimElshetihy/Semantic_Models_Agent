    "tables": [
      {
        "name": "FUND LEVELS",
        "columns": [
          {
            "name": "FUND_LEVEL_CODE",
            "dataType": "string",
            "sourceColumn": "FUND_LEVEL_CODE"
          },
          {
            "name": "FUND_LEVEL",
            "dataType": "string",
            "sourceColumn": "FUND_LEVEL",
            "sortByColumn": "FUND_LEVEL_CODE"
          }
        ],
        "partitions": [
          {
            "name": "Partition",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Value.NativeQuery(#\"Oracle/oracle-host:1521/oracle_service\", \"",
                "",
                "--FUND LEVELS",
                "SELECT DISTINCT",
                "--    substr(flex_value, 1, 1) fund_level_id,",
                "    flex_value fund_level_code,",
                "    CASE",
                "        WHEN t.description IN ( 'موارد ذاتية أخري', 'موارد ذاتية أخري مدرجة بموازنات الجهات' ) THEN",
                "            'موارد ذاتية'",
                "        ELSE",
                "            t.description",
                "    END        fund_level",
                "FROM",
                "         gfmis_fnd_flex_values_vl v",
                "    INNER JOIN gfmis_fnd_flex_values_tl t ON v.flex_value_id = t.flex_value_id",
                "WHERE",
                "    flex_value_set_id IN ( 1014147, 1017903 ) --BALANCING BODIES & ECONOMIC BODIES",
                "    AND t.language = 'AR'",
                "    AND flex_value IN ( '100000000', '200000000', '400000000', '501010101', '501010201' )",
                "ORDER BY",
                "    1",
                "",
                "\")",
                "in",
                "    Source"
              ]
            }
          }
        ]
      },
      {
        "name": "BUDGET TYPE",
        "columns": [
          {
            "name": "BUDGET_TYPE_CODE",
            "dataType": "string",
            "sourceColumn": "BUDGET_TYPE_CODE"
          },
          {
            "name": "BUDGET_TYPE",
            "dataType": "string",
            "sourceColumn": "BUDGET_TYPE",
            "sortByColumn": "BUDGET_TYPE_CODE"
          }
        ],
        "partitions": [
          {
            "name": "Partition",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Value.NativeQuery(#\"Oracle/oracle-host:1521/oracle_service\", \"",
                "",
                "--BUDGET TYPE",
                "SELECT DISTINCT",
                "    flex_value    budget_type_code,",
                "    t.description budget_type",
                "FROM",
                "         gfmis_fnd_flex_values_vl v",
                "    INNER JOIN gfmis_fnd_flex_values_tl t ON v.flex_value_id = t.flex_value_id",
                "WHERE",
                "    flex_value_set_id IN ( 1014153 ) --BALANCING BODIES & ECONOMIC BODIES",
                "    AND t.language = 'AR'",
                "    AND flex_value < '9'",
                "ORDER BY",
                "    1",
                "",
                "\")",
                "in",
                "    Source"
              ]
            }
          }
        ]
      },
