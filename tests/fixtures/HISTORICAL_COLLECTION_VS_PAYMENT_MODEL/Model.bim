      {
        "name": "SERVICE_ENTITY",
        "columns": [
          {
            "name": "GROUP_ID",
            "dataType": "double",
            "sourceColumn": "GROUP_ID"
          },
          {
            "name": "SERVICE_ENTITY_ID",
            "dataType": "string",
            "sourceColumn": "SERVICE_ENTITY_ID"
          },
          {
            "name": "SERVICE_ENTITY_AR",
            "dataType": "string",
            "sourceColumn": "SERVICE_ENTITY_AR"
          },
          {
            "name": "SERVICE_ENTITY_EN",
            "dataType": "string",
            "sourceColumn": "SERVICE_ENTITY_EN"
          },
          {
            "name": "ORIGINAL_ID",
            "dataType": "string",
            "sourceColumn": "ORIGINAL_ID"
          },
          {
            "name": "INTEGRATION_TYPE_ID",
            "dataType": "double",
            "sourceColumn": "INTEGRATION_TYPE_ID"
          },
          {
            "name": "SOURCE",
            "dataType": "string",
            "sourceColumn": "SOURCE"
          }
        ],
        "partitions": [
          {
            "name": "Partition",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Value.NativeQuery(#\"Oracle/oracle-host:1521/oracle_service\", \"",
                "",
                "SELECT",
                "    service_entity_id,",
                "    original_id,",
                "    service_entity_ar,",
                "    service_entity_en,",
                "    integration_type_id,",
                "    group_id,",
                "    source",
                "FROM",
                "    mdm_lkp_service_entity",
                "--------------------------------------------------------------------------------",
                "UNION ALL",
                "--------------------------------------------------------------------------------",
                "SELECT",
                "    'CHEQUE',",
                "    'CHEQUE',",
                "    n'شيكات',",
                "    n'Cheques',",
                "    0,",
                "    0,",
                "    'CHEQUE'",
                "FROM",
                "    dual",
                "",
                "\")",
                "in",
                "    Source"
              ]
            },
            "annotations": [
              {
                "name": "QueryEditorSerialization",
                "value": [
                  "<?xml version=\"1.0\" encoding=\"UTF-16\"?><Gemini xmlns=\"QueryEditorSerialization\"><AnnotationContent><![CDATA[<RSQueryCommandText>let",
                  "    Source = Value.NativeQuery(#\"Oracle/oracle-host:1521/oracle_service\", \"",
                  "",
                  "SELECT",
                  "    mdm_id Service_entity_id,",
                  "    biller_ar_name Service_entity_ar,",
                  "    biller_en_name Service_entity_en,",
                  "    group_id",
                  "FROM",
                  "    (",
                  "        WITH ent AS (",
                  "            SELECT",
                  "                en.ent_id,",
                  "                en.entity_type_id,",
                  "                en.ent_code,",
                  "                enl.ent_name",
                  "            FROM",
                  "                epay_entity_mst      en",
                  "                LEFT JOIN epay_entity_mst_lang enl ON en.ent_id = enl.ent_id",
                  "                                                      AND enl.lang_id = 2",
                  "        ), service_without_biller AS (",
                  "            SELECT",
                  "                *",
                  "            FROM",
                  "                ent",
                  "            WHERE",
                  "                ent_id IN (",
                  "                    SELECT DISTINCT",
                  "                        entity_id",
                  "                    FROM",
                  "                        epay_reconciliation.entity_settlement_accs@epay2",
                  "                    WHERE",
                  "                        service_id <> 99",
                  "                )",
                  "        ), pfo AS (",
                  "            SELECT DISTINCT",
                  "                pb.biller_pfo_id,",
                  "                biller_ar_name,",
                  "                biller_en_name,",
                  "                group_id",
                  "            FROM",
                  "                lkp_pfo_billers pb",
                  "        ), mdm_init AS (",
                  "            SELECT DISTINCT",
                  "                'B-' || biller_pfo_id mdm_id,",
                  "                biller_ar_name,",
                  "                biller_en_name,",
                  "                group_id",
                  "            FROM",
                  "                pfo",
                  "--------------------------------------------------------------------------------",
                  "            UNION ALL",
                  "--------------------------------------------------------------------------------",
                  "            SELECT DISTINCT",
                  "                CASE",
                  "                    WHEN biller_pfo_id IS NULL THEN",
                  "                        'M-' || merid",
                  "                    ELSE",
                  "                        'B-' || biller_pfo_id",
                  "                END mdm_id,",
                  "                biller_ar_name,",
                  "                biller_en_name,",
                  "                group_id",
                  "            FROM",
                  "                pos_billers_stg",
                  "        ), mdm_duplicates AS (",
                  "            SELECT",
                  "                mdm_id,",
                  "                COUNT(mdm_id)",
                  "            FROM",
                  "                mdm_init",
                  "            GROUP BY",
                  "                mdm_id",
                  "            HAVING",
                  "                COUNT(mdm_id) > 1",
                  "        ), mdm_duplicates_view AS (",
                  "            SELECT ",
                  "/*+ PARALLEL(16) */ DISTINCT",
                  "                a.mdm_id,",
                  "                a.group_id",
                  "            FROM",
                  "                mdm_init a",
                  "                LEFT JOIN mdm_init b ON a.mdm_id = b.mdm_id",
                  "            WHERE",
                  "                a.mdm_id IN (",
                  "                    SELECT",
                  "                        mdm_id",
                  "                    FROM",
                  "                        mdm_duplicates",
                  "                )",
                  "            ORDER BY",
                  "                1",
                  "        ), mdm AS (",
                  "            SELECT DISTINCT",
                  "                mdm_id,",
                  "                coalesce(to_char(TRIM(biller_ar_name)), to_char('أخرى'))  biller_ar_name,",
                  "                coalesce(to_char(TRIM(biller_en_name)), to_char('Other')) biller_en_name,",
                  "                coalesce(group_id, 0)                                     group_id",
                  "            FROM",
                  "                mdm_init",
                  "        )",
                  "        SELECT",
                  "            to_char(mdm_id)         mdm_id,",
                  "            to_char(biller_ar_name) biller_ar_name,",
                  "            to_char(biller_en_name) biller_en_name,",
                  "            group_id",
                  "        FROM",
                  "            mdm",
                  "--------------------------------------------------------------------------------",
                  "        UNION ALL",
                  "--------------------------------------------------------------------------------",
                  "        SELECT",
                  "            'CHEQUE'  mdm_id,",
                  "            'شيكات'   biller_ar_name,",
                  "            'Cheques' biller_en_name,",
                  "            0         group_id",
                  "        FROM",
                  "            dual",
                  "--------------------------------------------------------------------------------",
                  "        UNION ALL",
                  "--------------------------------------------------------------------------------",
                  "        SELECT DISTINCT",
                  "            MAX(",
                  "                CASE",
                  "                    WHEN entity_type_id = 1 THEN",
                  "                        'SP-'",
                  "                    WHEN entity_type_id = 2 THEN",
                  "                        'FE-'",
                  "                    WHEN entity_type_id = 3 THEN",
                  "                        'PO-'",
                  "                END",
                  "                || ent_id)",
                  "            OVER(PARTITION BY ent_id)           mdm_id,",
                  "            coalesce(to_char(ent_name), 'أخرى') mdm_ar_name,",
                  "            coalesce(to_char(ent_name), 'أخرى') mdm_en_name,",
                  "            CASE",
                  "                WHEN sb.ent_id = 58   THEN",
                  "                    60",
                  "                WHEN sb.ent_id = 60   THEN",
                  "                    1",
                  "                WHEN sb.ent_id = 3690 THEN",
                  "                    5",
                  "                ELSE",
                  "                    0",
                  "            END",
                  "        FROM",
                  "            ent sb",
                  "--------------------------------------------------------------------------------",
                  "        UNION ALL",
                  "--------------------------------------------------------------------------------",
                  "        SELECT",
                  "            'B-'            mdm_id,",
                  "            'أخرى'          biller_ar_name,",
                  "            'Other Billers' biller_en_name,",
                  "            0               group_id",
                  "        FROM",
                  "            dual",
                  "    )",
                  "",
                  "\")",
                  "in",
                  "    Source</RSQueryCommandText><RSQueryCommandType>Text</RSQueryCommandType><RSQueryDesignState></RSQueryDesignState>]]></AnnotationContent></Gemini>"
                ]
              }
            ]
          }
        ]
      },
