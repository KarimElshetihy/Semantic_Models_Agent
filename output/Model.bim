{
  "name": "SemanticModel",
  "compatibilityLevel": 1500,
  "model": {
    "culture": "en-US",
    "dataSources": [
      {
        "type": "structured",
        "name": "Oracle/oracle-host:1521/oracle_service",
        "connectionDetails": {
          "protocol": "oracle",
          "address": {
            "server": "oracle-host:1521/oracle_service"
          },
          "authentication": null,
          "query": null
        },
        "options": {
          "hierarchicalNavigation": true
        },
        "credential": {
          "AuthenticationKind": "UsernamePassword",
          "kind": "Oracle",
          "path": "oracle-host:1521/oracle_service",
          "Username": "oracle_user"
        }
      }
    ],
    "tables": [
      {
        "name": "TRX",
        "columns": [
          {
            "name": "SETTLEMENT_DATE",
            "dataType": "dateTime",
            "sourceColumn": "SETTLEMENT_DATE"
          },
          {
            "name": "BUSINESS_DATE",
            "dataType": "dateTime",
            "sourceColumn": "BUSINESS_DATE"
          },
          {
            "name": "CHANNEL_ID",
            "dataType": "double",
            "sourceColumn": "CHANNEL_ID"
          },
          {
            "name": "FE_ID",
            "dataType": "double",
            "sourceColumn": "FE_ID"
          },
          {
            "name": "TRX_COUNT",
            "dataType": "double",
            "sourceColumn": "TRX_COUNT"
          },
          {
            "name": "AMOUNT",
            "dataType": "double",
            "sourceColumn": "AMOUNT"
          },
          {
            "name": "SERVICE_CODE",
            "dataType": "string",
            "sourceColumn": "SERVICE_CODE"
          },
          {
            "name": "GOVERNORATE_NAME",
            "dataType": "string",
            "sourceColumn": "GOVERNORATE_NAME"
          },
          {
            "name": "ACCOUNT_TYPE",
            "dataType": "string",
            "sourceColumn": "ACCOUNT_TYPE"
          },
          {
            "name": "BUDGET_CATEGORY",
            "dataType": "string",
            "sourceColumn": "BUDGET_CATEGORY"
          },
          {
            "name": "IS_COMMERCIAL",
            "dataType": "double",
            "sourceColumn": "IS_COMMERCIAL"
          },
          {
            "name": "UNIT_CODE",
            "dataType": "string",
            "sourceColumn": "UNIT_CODE"
          },
          {
            "name": "SOURCE_SYSTEM",
            "dataType": "string",
            "sourceColumn": "SOURCE_SYSTEM"
          },
          {
            "name": "IS_INTEGRATED",
            "dataType": "double",
            "sourceColumn": "IS_INTEGRATED"
          },
          {
            "type": "calculated",
            "name": "DATE_KEY",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": " FORMAT(TRX[SETTLEMENT_DATE], \"YYYYMMDD\")"
          },
          {
            "name": "GOVERNORATE_NAME_EN",
            "dataType": "string",
            "sourceColumn": "GOVERNORATE_NAME_EN"
          }
        ],
        "partitions": [
          {
            "name": "2026",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Value.NativeQuery(#\"Oracle/oracle-host:1521/oracle_service\", \"",
                "",
                "select * from reta_trx_agg",
                "",
                "\")",
                "in",
                "    Source"
              ]
            },
            "annotations": [
              {
                "name": "QueryEditorSerialization",
                "value": [
                  "<?xml version=\"1.0\" encoding=\"UTF-16\"?><Gemini xmlns=\"QueryEditorSerialization\"><AnnotationContent><![CDATA[<RSQueryCommandText>let",
                  "    Source = Value.NativeQuery(#\"Oracle/oracle-host:1521/oracle_service\", \"",
                  "",
                  "WITH pos_gov AS (",
                  "    SELECT DISTINCT",
                  "        tblinistitution_id,",
                  "        ins.inistitcode,",
                  "        ins.inistitname,",
                  "        bra.inistitbarchcode,",
                  "        inistitbarchname,",
                  "        inistitbarchnamearb,",
                  "        bra.accno,",
                  "        zone_code,",
                  "        name zone,",
                  "        CASE",
                  "            WHEN zon.name LIKE '%القاهرة%'",
                  "                 OR zon.name LIKE '%القاهره%'",
                  "                 OR zon.name LIKE '%شمال القاهرة%'",
                  "                 OR zon.name LIKE '%شمال القاهره%'",
                  "                 OR zon.name LIKE '%جنوب القاهرة%'",
                  "                 OR zon.name LIKE '%جنوب القاهره%'",
                  "                 OR zon.name LIKE '%شرق القاهرة%'",
                  "                 OR zon.name LIKE '%شرق القاهره%'",
                  "                 OR zon.name LIKE '%وسط القاهرة%'",
                  "                 OR zon.name LIKE '%وسط القاهره%'",
                  "                 OR zon.name LIKE '%حلوان%'",
                  "                 OR zon.name LIKE '%مصر القديمة%'",
                  "                 OR zon.name LIKE '%العاشر من رمضان%' THEN",
                  "                'القاهرة'",
                  "            WHEN zon.name LIKE '%الجيزة%'",
                  "                 OR zon.name LIKE '%شمال الجيزة%' THEN",
                  "                'الجيزة'",
                  "            WHEN zon.name LIKE '%الاسكندرية%'",
                  "                 OR zon.name LIKE '%الإسكندرية%'",
                  "                 OR zon.name LIKE '%شرق الاسكندرية%'",
                  "                 OR zon.name LIKE '%غرب الاسكندرية%' THEN",
                  "                'الإسكندرية'",
                  "            WHEN zon.name LIKE '%القليوبية%'",
                  "                 OR zon.name LIKE '%القليوبيه%'",
                  "                 OR zon.name LIKE '%بنها%' THEN",
                  "                'القليوبية'",
                  "            WHEN zon.name LIKE '%الدقهلية%'",
                  "                 OR zon.name LIKE '%الدقهليه%'",
                  "                 OR zon.name LIKE '%المنصورة%'",
                  "                 OR zon.name LIKE '%المنصوره%' THEN",
                  "                'الدقهلية'",
                  "            WHEN zon.name LIKE '%الغربية%'",
                  "                 OR zon.name LIKE '%الغربيه%' THEN",
                  "                'الغربية'",
                  "            WHEN zon.name LIKE '%المنوفية%'",
                  "                 OR zon.name LIKE '%المنوفيه%'",
                  "                 OR zon.name LIKE '%شبين الكوم%' THEN",
                  "                'المنوفية'",
                  "            WHEN zon.name LIKE '%البحيرة%'",
                  "                 OR zon.name LIKE '%دمنهور%' THEN",
                  "                'البحيرة'",
                  "            WHEN zon.name LIKE '%كفر الشيخ%' THEN",
                  "                'كفر الشيخ'",
                  "            WHEN zon.name LIKE '%دمياط%' THEN",
                  "                'دمياط'",
                  "            WHEN zon.name LIKE '%بورسعيد%'",
                  "                 OR zon.name LIKE '%بور سعيد%' THEN",
                  "                'بورسعيد'",
                  "            WHEN zon.name LIKE '%الإسماعيلية%'",
                  "                 OR zon.name LIKE '%الاسماعيلية%'",
                  "                 OR zon.name LIKE '%الاسماعيليه%' THEN",
                  "                'الإسماعيلية'",
                  "            WHEN zon.name LIKE '%السويس%' THEN",
                  "                'السويس'",
                  "            WHEN zon.name LIKE '%شمال سيناء%' THEN",
                  "                'شمال سيناء'",
                  "            WHEN zon.name LIKE '%جنوب سيناء%' THEN",
                  "                'جنوب سيناء'",
                  "            WHEN zon.name LIKE '%الفيوم%' THEN",
                  "                'الفيوم'",
                  "            WHEN zon.name LIKE '%بني سويف%'",
                  "                 OR zon.name LIKE '%بنى سويف%' THEN",
                  "                'بني سويف'",
                  "            WHEN zon.name LIKE '%المنيا%' THEN",
                  "                'المنيا'",
                  "            WHEN zon.name LIKE '%أسيوط%'",
                  "                 OR zon.name LIKE '%اسيوط%' THEN",
                  "                'أسيوط'",
                  "            WHEN zon.name LIKE '%سوهاج%' THEN",
                  "                'سوهاج'",
                  "            WHEN zon.name LIKE '%قنا%' THEN",
                  "                'قنا'",
                  "            WHEN zon.name LIKE '%الأقصر%'",
                  "                 OR zon.name LIKE '%الاقصر%' THEN",
                  "                'الأقصر'",
                  "            WHEN zon.name LIKE '%أسوان%'",
                  "                 OR zon.name LIKE '%اسوان%' THEN",
                  "                'أسوان'",
                  "            WHEN zon.name LIKE '%البحر الأحمر%'",
                  "                 OR zon.name LIKE '%البحر الاحمر%' THEN",
                  "                'البحر الأحمر'",
                  "            WHEN zon.name LIKE '%الوادى الجديد%'",
                  "                 OR zon.name LIKE '%الوادى الجديد%'",
                  "                 OR zon.name LIKE '%الوادي الجديد%' THEN",
                  "                'الوادي الجديد'",
                  "            WHEN zon.name LIKE '%مطروح%'",
                  "                 OR zon.name LIKE '%مرسى مطروح%' THEN",
                  "                'مطروح'",
                  "            WHEN zon.name LIKE '%الشرقية%' THEN",
                  "                'الشرقية'",
                  "            ELSE",
                  "                'الديوان العام'",
                  "        END  governorate_name",
                  "    FROM",
                  "        sts_tblinistitution ins",
                  "        LEFT JOIN sts_tblinistbranchs bra ON bra.inistitcode = ins.inistitcode",
                  "        LEFT JOIN sts_zone            zon ON bra.zonecode = zon.zone_code",
                  "    WHERE",
                  "        bra.inistitcode = '94'",
                  "), epay_gov AS (",
                  "    SELECT",
                  "        rb.id          biller_id,",
                  "        rb.ar_name     biller_name,",
                  "        rb.id          sub_biller_id,",
                  "        rp.name        service_name,",
                  "        rp.code        acc_off_dtl_id,",
                  "        rp.rc_acc_name sub_service,",
                  "        CASE",
                  "            WHEN rp.rc_acc_name LIKE '%القاهرة%' THEN",
                  "                'القاهرة'",
                  "            WHEN rp.rc_acc_name LIKE '%الجيزة%' THEN",
                  "                'الجيزة'",
                  "            WHEN rp.rc_acc_name LIKE '%الإسكندرية%'",
                  "                 OR rp.rc_acc_name LIKE '%الاسكندرية%' THEN",
                  "                'الإسكندرية'",
                  "            WHEN rp.rc_acc_name LIKE '%القليوبية%' THEN",
                  "                'القليوبية'",
                  "            WHEN rp.rc_acc_name LIKE '%الدقهلية%' THEN",
                  "                'الدقهلية'",
                  "            WHEN rp.rc_acc_name LIKE '%الشرقية%' THEN",
                  "                'الشرقية'",
                  "            WHEN rp.rc_acc_name LIKE '%الغربية%' THEN",
                  "                'الغربية'",
                  "            WHEN rp.rc_acc_name LIKE '%المنوفية%' THEN",
                  "                'المنوفية'",
                  "            WHEN rp.rc_acc_name LIKE '%البحيرة%' THEN",
                  "                'البحيرة'",
                  "            WHEN rp.rc_acc_name LIKE '%كفر الشيخ%' THEN",
                  "                'كفر الشيخ'",
                  "            WHEN rp.rc_acc_name LIKE '%دمياط%' THEN",
                  "                'دمياط'",
                  "            WHEN rp.rc_acc_name LIKE '%بورسعيد%'",
                  "                 OR rp.rc_acc_name LIKE '%بور سعيد%' THEN",
                  "                'بورسعيد'",
                  "            WHEN rp.rc_acc_name LIKE '%الإسماعيلية%'",
                  "                 OR rp.rc_acc_name LIKE '%الاسماعيلية%' THEN",
                  "                'الإسماعيلية'",
                  "            WHEN rp.rc_acc_name LIKE '%السويس%' THEN",
                  "                'السويس'",
                  "            WHEN rp.rc_acc_name LIKE '%شمال سيناء%' THEN",
                  "                'شمال سيناء'",
                  "            WHEN rp.rc_acc_name LIKE '%جنوب سيناء%' THEN",
                  "                'جنوب سيناء'",
                  "            WHEN rp.rc_acc_name LIKE '%الفيوم%' THEN",
                  "                'الفيوم'",
                  "            WHEN rp.rc_acc_name LIKE '%بني سويف%'",
                  "                 OR rp.rc_acc_name LIKE '%بنى سويف%' THEN",
                  "                'بني سويف'",
                  "            WHEN rp.rc_acc_name LIKE '%المنيا%' THEN",
                  "                'المنيا'",
                  "            WHEN rp.rc_acc_name LIKE '%أسيوط%'",
                  "                 OR rp.rc_acc_name LIKE '%اسيوط%' THEN",
                  "                'أسيوط'",
                  "            WHEN rp.rc_acc_name LIKE '%سوهاج%' THEN",
                  "                'سوهاج'",
                  "            WHEN rp.rc_acc_name LIKE '%قنا%' THEN",
                  "                'قنا'",
                  "            WHEN rp.rc_acc_name LIKE '%الأقصر%'",
                  "                 OR rp.rc_acc_name LIKE '%الاقصر%' THEN",
                  "                'الأقصر'",
                  "            WHEN rp.rc_acc_name LIKE '%أسوان%'",
                  "                 OR rp.rc_acc_name LIKE '%اسوان%' THEN",
                  "                'أسوان'",
                  "            WHEN rp.rc_acc_name LIKE '%البحر الأحمر%'",
                  "                 OR rp.rc_acc_name LIKE '%البحر الاحمر%' THEN",
                  "                'البحر الأحمر'",
                  "            WHEN rp.rc_acc_name LIKE '%الوادي الجديد%'",
                  "                 OR rp.rc_acc_name LIKE '%الوادى الجديد%' THEN",
                  "                'الوادي الجديد'",
                  "            WHEN rp.rc_acc_name LIKE '%مطروح%' THEN",
                  "                'مطروح'",
                  "            ELSE",
                  "                'الديوان العام'",
                  "        END            AS governorate_name",
                  "    FROM",
                  "        reporting_biller                rb",
                  "        LEFT JOIN reporting_settlement_account_rp rp ON rb.id = rp.biller_id",
                  "    WHERE",
                  "        rb.id = '42008'",
                  "), trx AS (",
                  "    SELECT",
                  "        a.settlement_date                             AS settlement_date,",
                  "        a.business_date,",
                  "        a.channel_id,",
                  "        a.fe_id,",
                  "        COUNT(DISTINCT a.epay_txn_no)                 trx_count,",
                  "        SUM(sd.amt)                                   AS amount,",
                  "        'EP-'",
                  "        || a.sp_id",
                  "        || '-'",
                  "        || sd.acc_off_dtl_id                          service_code,",
                  "        gov.governorate_name,",
                  "        coalesce(ent.account_type, u'COMM')           account_type,",
                  "        coalesce(to_char(ent.budget_category), '000') budget_category,",
                  "        coalesce(ent.is_commercial, 0)                is_commercial,",
                  "        coalesce(to_char(ent.unit_code), '00000000')  unit_code,",
                  "        'EPAY'                                        source_system,",
                  "        1                                             is_integrated",
                  "    FROM",
                  "             epaysettm.epay_transaction a",
                  "        INNER JOIN oracle_user.txn_settlement_dtl sd ON a.epay_txn_no = sd.epay_txn_no",
                  "                                                      AND sd.entity_id = a.sp_id",
                  "        LEFT JOIN mdm_lkp_ent_accounts         ent ON sd.entity_id = ent.entity_id",
                  "                                              AND sd.acc_off_dtl_id = ent.acc_off_dtl_id",
                  "                                              AND sd.rc_account_no = ent.rc_acc_no",
                  "        LEFT JOIN epay_gov                     gov ON sd.acc_off_dtl_id = gov.acc_off_dtl_id",
                  "    WHERE",
                  "        a.settlement_date BETWEEN '01-JAN-2026' AND trunc(sysdate)",
                  "        AND a.sp_id = 42008",
                  "        AND a.channel_id <> 3",
                  "        AND sd.amt_sign = 'C'",
                  "    GROUP BY",
                  "        a.sp_id,",
                  "        a.settlement_date,",
                  "        a.business_date,",
                  "        a.channel_id,",
                  "        a.fe_id,",
                  "        sd.acc_off_dtl_id,",
                  "        ent.account_type,",
                  "        ent.budget_category,",
                  "        ent.is_commercial,",
                  "        ent.unit_code,",
                  "        gov.governorate_name",
                  "--------------------------------------------------------------------------------",
                  "    UNION ALL",
                  "--------------------------------------------------------------------------------  ",
                  "    SELECT",
                  "        a.settlement_date                                     AS settlement_date,",
                  "        a.business_date,",
                  "        a.channel_id,",
                  "        a.fe_id,",
                  "        COUNT(DISTINCT a.epay_txn_no)                         trx_count,",
                  "        SUM(sd.amt)                                           AS amount,",
                  "        'EP-'",
                  "        || a.sp_id",
                  "        || '-'",
                  "        || sd.acc_off_dtl_id                                  service_code,",
                  "        'الديوان العام'                                       governorate_name,",
                  "        coalesce(ent.account_type, n'COMM')                   account_type,",
                  "        coalesce(to_char(substr(ent.rc_acc_no, 1, 3)), '301') budget_category,",
                  "        coalesce(ent.is_commercial, 0)                        is_commercial,",
                  "        coalesce(substr(a.billing_account, 1, 8), '00000000') unit_code,",
                  "        'EPAY'                                                source_system,",
                  "        1                                                     is_integrated",
                  "    FROM",
                  "             epaysettm.epay_transaction a",
                  "        INNER JOIN oracle_user.txn_settlement_dtl sd ON a.epay_txn_no = sd.epay_txn_no",
                  "                                                      AND sd.entity_id = a.sp_id",
                  "        LEFT JOIN mdm_lkp_ent_accounts         ent ON a.sp_id = ent.entity_id",
                  "                                              AND sd.acc_off_dtl_id = ent.acc_off_dtl_id",
                  "                                              AND sd.rc_account_no = ent.rc_acc_no",
                  "    WHERE",
                  "        a.sp_id IN (",
                  "            SELECT DISTINCT",
                  "                sp_id",
                  "            FROM",
                  "                mdm_lkp_service_hierarchy",
                  "            WHERE",
                  "                unit_code = '00000001'",
                  "        )",
                  "        AND substr(a.billing_account, 1, 6) = '106005'",
                  "        AND a.settlement_date BETWEEN '01-JAN-2026' AND trunc(sysdate)",
                  "        AND sd.amt_sign = 'C'",
                  "    GROUP BY",
                  "        a.sp_id,",
                  "        a.settlement_date,",
                  "        a.business_date,",
                  "        a.channel_id,",
                  "        a.fe_id,",
                  "        sd.acc_off_dtl_id,",
                  "        ent.account_type,",
                  "        substr(ent.rc_acc_no, 1, 3),",
                  "        ent.is_commercial,",
                  "        substr(a.billing_account, 1, 8)      ",
                  "--------------------------------------------------------------------------------",
                  "    UNION ALL",
                  "--------------------------------------------------------------------------------   ",
                  "    SELECT",
                  "        s.cbe_date                                    AS settlement_date,",
                  "        a.business_date,",
                  "        a.channel_id,",
                  "        a.fe_id,",
                  "        COUNT(DISTINCT a.epay_txn_no)                 trx_count,",
                  "        SUM(",
                  "            CASE",
                  "                WHEN length(sd.rc_account_no) = 10",
                  "                     AND s.setldate < DATE '2026-11-01' THEN",
                  "                    sd.amt * 0.99479",
                  "                ELSE",
                  "                    sd.amt",
                  "            END",
                  "        )                                             AS amount,",
                  "        'EP-'",
                  "        || sd.entity_id",
                  "        || '-'",
                  "        || sd.acc_off_dtl_id                          service_code,",
                  "        gov.governorate_name,",
                  "        coalesce(ent.account_type, u'COMM')           account_type,",
                  "        coalesce(to_char(ent.budget_category), '000') budget_category,",
                  "        coalesce(ent.is_commercial, 0)                is_commercial,",
                  "        coalesce(to_char(ent.unit_code), '00000000')  unit_code,",
                  "        'GOV'                                         source_system,",
                  "        1                                             is_integrated",
                  "    FROM",
                  "             sts_tblhistorylog_bk s",
                  "        INNER JOIN epaysettm.epay_transaction   a ON a.epay_txn_no = regexp_substr(s.acqcurr, '[^|]+', 1, 2)",
                  "                                                   AND a.sp_id = 42008",
                  "        INNER JOIN oracle_user.txn_settlement_dtl sd ON regexp_substr(s.acqcurr, '[^|]+', 1, 2) = sd.epay_txn_no",
                  "                                                      AND sd.entity_id = 42008",
                  "        LEFT JOIN mdm_lkp_ent_accounts         ent ON sd.entity_id = ent.entity_id",
                  "                                              AND sd.acc_off_dtl_id = ent.acc_off_dtl_id",
                  "                                              AND sd.rc_account_no = ent.rc_acc_no",
                  "        LEFT JOIN epay_gov                     gov ON sd.acc_off_dtl_id = gov.acc_off_dtl_id",
                  "    WHERE",
                  "        s.cbe_date BETWEEN '01-JAN-2026' AND trunc(sysdate)",
                  "            --AND sp.sp_id = 42008",
                  "            --AND a.channel_id = 3",
                  "        AND s.trnsorc = '94'",
                  "        AND s.networkcode IN ( '42', '43', '10' )",
                  "        AND s.inistituion_id = '67'",
                  "        AND instr(s.acqcurr, '-') = 0",
                  "        AND s.actioncod IN ( '0', '112' )",
                  "        AND sd.amt_sign = 'C'",
                  "    GROUP BY",
                  "        sd.entity_id,",
                  "        s.cbe_date,",
                  "        a.business_date,",
                  "        a.channel_id,",
                  "        a.fe_id,",
                  "        sd.acc_off_dtl_id,",
                  "        ent.account_type,",
                  "        ent.budget_category,",
                  "        ent.is_commercial,",
                  "        ent.unit_code,",
                  "        gov.governorate_name",
                  "--------------------------------------------------------------------------------",
                  "    UNION ALL",
                  "--------------------------------------------------------------------------------        ",
                  "    SELECT",
                  "        bk.cbe_date,",
                  "        bk.setldate      AS business_date,",
                  "        3                channel_id,",
                  "        2096             fe_id,",
                  "        COUNT(bk.id)     cnt,",
                  "        SUM(bk.setlamnt) amount,",
                  "        'MER-' || bk.merid,",
                  "        gov.governorate_name,",
                  "        u'TSA'           account_type,",
                  "        cb.code          budget_category,",
                  "        0                is_commercial,",
                  "        bra.accno        unit_code,",
                  "        'GOV'            source_system,",
                  "        0                is_integrated",
                  "    FROM",
                  "        sts_tblhistorylog_bk bk",
                  "        LEFT JOIN sts_tblinistbranchs  bra ON bk.merid = bra.inistitbarchcode",
                  "        LEFT JOIN sts_zone             zon ON bra.zonecode = zon.zone_code",
                  "                                  AND bra.inistitcode = zon.pen_typ",
                  "        LEFT JOIN pos_gov              gov ON zon.zone_code = gov.zone_code",
                  "                                 AND zon.tblinistitution_id = gov.tblinistitution_id",
                  "                                 AND gov.inistitbarchcode = bra.inistitbarchcode",
                  "        LEFT JOIN sts_cbe_lookup       cb ON substr(bk.acqcurr, 1, 3) = cb.settlement_budget_code",
                  "    WHERE",
                  "        cbe_date BETWEEN '01-JAN-2026' AND trunc(sysdate)",
                  "        AND trnsorc IN ( '94' )",
                  "        AND instr(acqcurr, '-') <> 0",
                  "        AND networkcode IN ( '42', '43', '10' )",
                  "    GROUP BY",
                  "        cbe_date,",
                  "        bk.setldate,",
                  "        cb.code,",
                  "        bra.accno,",
                  "        bk.merid,",
                  "        gov.governorate_name",
                  ")",
                  "SELECT /*+ PARALLEL(4) */",
                  "    *",
                  "FROM",
                  "    trx",
                  "",
                  "\")",
                  "in",
                  "    Source</RSQueryCommandText><RSQueryCommandType>Text</RSQueryCommandType><RSQueryDesignState></RSQueryDesignState>]]></AnnotationContent></Gemini>"
                ]
              }
            ]
          }
        ],
        "measures": [
          {
            "name": "_TRX_COUNT_DETAILED",
            "expression": " SUM(TRX[TRX_COUNT])",
            "formatString": "#,0"
          },
          {
            "name": "_TRX_AMOUNT",
            "expression": "SUM ( 'TRX'[AMOUNT] ) + 0",
            "formatString": "#,0.00"
          }
        ]
      },
