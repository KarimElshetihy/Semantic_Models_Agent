          },
          {
            "name": "PROJECT_NUMBER",
            "dataType": "double",
            "sourceColumn": "PROJECT_NUMBER"
          }
        ],
        "partitions": [
          {
            "name": "Partition",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Value.NativeQuery(#\"Oracle/oracle-host:1521/oracle_service\", \"",
                "",
                "SELECT",
                "    act.id                   activity_id,",
                "    name                 activity_name,",
                "    activitytype         activity_type,",
                "    status               activity_status,",
                "    trunc(act.created)       created_at,",
                "    lastupdate           last_update,",
                "    finalcontractedvalue contract_value,",
                "    act.accountid            account_id,",
                "    acc.title account_name,",
                "    acc.territory,",
                "    act.account_manager,",
                "    financialproposal    has_financial_proposal,",
                "    technicalproposal    has_technical_proposal,",
                "    expectedduedate      due_date,",
                "    priority,",
                "    closer_q,",
                "    year,",
                "    product_type,",
                "    business_owner,",
                "    technical_owner,",
                "    prj.project_id,",
                "    prj.project_number",
                "FROM",
                "    business_mangment_lkp__activity  act",
                "    LEFT JOIN business_mangment_lkp_account acc ON act.accountid = acc.id",
                "    LEFT JOIN erp_app_lkp_project_activity_map prj ON act.id = prj.activity_id",
                "",
                "\")",
                "in",
                "    Source"
              ]
            }
          }
        ]
