            "sourceColumn": "RUN_TYPE_ID"
          },
          {
            "name": "CREATION_DATE",
            "dataType": "dateTime",
            "sourceColumn": "CREATION_DATE"
          },
          {
            "name": "GENDER",
            "dataType": "string",
            "sourceColumn": "GENDER"
          },
          {
            "name": "ASSIGNMENT_STATUS_TYPE_ID",
            "dataType": "double",
            "sourceColumn": "ASSIGNMENT_STATUS_TYPE_ID"
          },
          {
            "name": "GRADE_CATEGORY",
