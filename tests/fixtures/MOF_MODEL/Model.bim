        "measures": [
          {
            "name": "01.MONSAREF_BANKY",
            "expression": [
              " CALCULATE([BALANCE_], FILTER(DIM_DATE, DIM_DATE[FISCAL_MONTH] = MAX(DIM_DATE[FISCAL_MONTH])),",
              "                     DATESBETWEEN(TSA[POSTING_DATE], MIN('UNITS HIERARCHY'[EFFECTIVE_DATE_FROM]), MAX('UNITS HIERARCHY'[EFFECTIVE_DATE_TO]))",
              "\t)"
            ]
          },
          {
            "name": "01.MONSAREF_BANKY_FORMATTED",
            "expression": [
              " ",
              "VAR VALUE_ = [01.MONSAREF_BANKY]",
              "RETURN",
              "SWITCH(",
              "    TRUE(),",
              "    ABS(VALUE_) < 1000, FORMAT(VALUE_, \"#,##0.00\"),",
              "    ABS(VALUE_) >= 1000 && ABS(VALUE_) < 1000000, FORMAT(VALUE_ / 1000, \"#,##0.00\") & \" K\",",
              "    ABS(VALUE_) >= 1000000 && ABS(VALUE_) < 1000000000, FORMAT(VALUE_ / 1000000, \"#,##0.00\") & \" M\",",
              "    ABS(VALUE_) >= 1000000000, FORMAT(VALUE_ / 1000000000, \"#,##0.00\") & \" B\"",
              ")"
            ]
          },
          {
            "name": "02.DIFF_FE3LEYAT_MONSAREF_BANKY",
            "expression": " GFMIS[03.FE3LYAT] - TSA[01.MONSAREF_BANKY]",
            "formatString": "#,0.00"
          },
          {
            "name": "monsfrformated",
            "expression": [
              "",
              "VAR VALUE_ = [01.MONSAREF_BANKY]",
              "RETURN",
              "SWITCH(",
              "    TRUE(),",
              "    ABS(VALUE_) < 1000, FORMAT(VALUE_, \"#,##0\"),",
              "    ABS(VALUE_) >= 1000 && ABS(VALUE_) < 1000000, FORMAT(VALUE_ / 1000, \"#,##0\") & \" K\",",
              "    ABS(VALUE_) >= 1000000 && ABS(VALUE_) < 1000000000, FORMAT(VALUE_ / 1000000, \"#,##0\") & \" M\",",
              "    ABS(VALUE_) >= 1000000000, FORMAT(VALUE_ / 1000000000, \"#,##0\") & \" B\"",
              ")"
            ]
          },
          {
            "name": "BALANCE_",
            "expression": [
              " ABS(SUM(TSA[BALANCE]))",
              ""
            ],
            "formatString": "#,0.00"
          }
        ]
      },
      {
        "name": "BUDGET_CATEGORY_TYPE",
        "columns": [
          {
            "name": "BUDGET_CATEGORY_TYPE_ID",
            "dataType": "string",
            "sourceColumn": "BUDGET_CATEGORY_TYPE_ID"
          },
          {
            "name": "BUDGET_CATEGORY_TYPE_CODE",
            "dataType": "string",
            "sourceColumn": "BUDGET_CATEGORY_TYPE_CODE"
          },
          {
            "name": "BUDGET_CATEGORY_TYPE",
            "dataType": "string",
            "sourceColumn": "BUDGET_CATEGORY_TYPE"
          }
        ],
        "partitions": [
          {
            "name": "Partition",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Value.NativeQuery(#\"Oracle/oracle-host:1521/oracle_service\", \"",
                "",
                "--BUDGET CATEGORY TYPE",
                "SELECT DISTINCT",
                "    substr(flex_value, 1, 1) budget_category_type_id,",
                "    flex_value               budget_category_type_code,",
                "    t.description            budget_category_type",
                "FROM",
                "         gfmis_fnd_flex_values_vl v",
                "    INNER JOIN gfmis_fnd_flex_values_tl t ON v.flex_value_id = t.flex_value_id",
                "WHERE",
                "    flex_value_set_id IN ( 1014151, 1017907 ) --BALANCING BODIES & ECONOMIC BODIES",
                "    AND t.language = 'AR'",
                "    AND flex_value = substr(flex_value, 1, 1)",
                "                     || '0000000'",
                "ORDER BY",
                "    1",
                "",
                "\")",
                "in",
                "    Source"
              ]
            }
          }
        ]
      },
      {
        "name": "BUDGET_CATEGORY",
        "columns": [
          {
            "name": "BUDGET_CATEGORY_TYPE",
            "dataType": "string",
            "sourceColumn": "BUDGET_CATEGORY_TYPE",
            "sortByColumn": "BUDGET_CATEGORY_TYPE_CODE"
          },
          {
            "name": "BUDGET_CATEGORY_TYPE_CODE",
            "dataType": "string",
            "sourceColumn": "BUDGET_CATEGORY_TYPE_CODE"
          },
          {
            "name": "BUDGET_CATEGORY_ID",
            "dataType": "string",
            "sourceColumn": "BUDGET_CATEGORY_ID"
          },
          {
            "name": "BUDGET_CATEGORY_CODE",
            "dataType": "string",
            "sourceColumn": "BUDGET_CATEGORY_CODE"
          },
          {
            "name": "BUDGET_CATEGORY",
            "dataType": "string",
            "sourceColumn": "BUDGET_CATEGORY"
          },
          {
            "name": "TYPE",
            "dataType": "string",
            "sourceColumn": "TYPE",
            "sortByColumn": "TYPE_ID"
          },
          {
            "name": "BALANCING_OR_ECONOMIC",
            "dataType": "string",
            "sourceColumn": "BALANCING_OR_ECONOMIC"
          },
          {
            "type": "calculated",
            "name": "BUDGET_CATEGORY_WITH_CODE",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": "BUDGET_CATEGORY[BUDGET_CATEGORY_ID] & \"-\" & BUDGET_CATEGORY[BUDGET_CATEGORY]"
          },
          {
            "name": "TYPE_ID",
            "dataType": "string",
            "sourceColumn": "TYPE_ID"
          }
        ],
        "partitions": [
          {
            "name": "Partition",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Value.NativeQuery(#\"Oracle/oracle-host:1521/oracle_service\", \"",
                "",
                "--### BUDGET CATEGORIES MAPPING (GFMIS/TSA)###",
                "WITH tsa_budget_categories AS (",
                "    SELECT",
                "        id,",
                "        budget_category_type_id,",
                "        code,",
                "        ar_name,",
                "        CASE",
                "            WHEN code = '01'",
                "                 AND budget_category_type_id = 1 THEN",
                "                '21100000'",
                "            WHEN code = '02'",
                "                 AND budget_category_type_id = 1 THEN",
                "                '21200000'",
                "            WHEN code = '03'",
                "                 AND budget_category_type_id = 1 THEN",
                "                '21300000'",
                "            WHEN code = '04'",
                "                 AND budget_category_type_id = 1 THEN",
                "                '21400000'",
                "            WHEN code = '05'",
                "                 AND budget_category_type_id = 1 THEN",
                "                '21500000'",
                "            WHEN code = '06'",
                "                 AND budget_category_type_id = 1 THEN",
                "                '21600000'",
                "            WHEN code = '07'",
                "                 AND budget_category_type_id = 1 THEN",
                "                '22700000'",
                "            WHEN code = '08'",
                "                 AND budget_category_type_id = 1 THEN",
                "                '23800000'",
                "            WHEN code = '09'",
                "                 AND budget_category_type_id = 1 THEN",
                "                '21600000'",
                "            WHEN code = '01'",
                "                 AND budget_category_type_id = 2 THEN",
                "                '11100000'",
                "            WHEN code = '02'",
                "                 AND budget_category_type_id = 2 THEN",
                "                '11200000'",
                "            WHEN code = '03'",
                "                 AND budget_category_type_id = 2 THEN",
                "                '11300000'",
                "            WHEN code = '04'",
                "                 AND budget_category_type_id = 2 THEN",
                "                '12400000'",
                "            WHEN code = '05'",
                "                 AND budget_category_type_id = 2 THEN",
                "                '13500000'",
                "        END door_code",
                "    FROM",
                "        tsa_budget_category bc",
                "    WHERE",
                "        budget_category_type_id IN ( 1, 2 )",
                "), gfmis_balancing_doors AS (",
                "    SELECT DISTINCT",
                "        substr(flex_value, 1, 3) door_id,",
                "        flex_value               door_code,",
                "        t.description            door_name,",
                "        CASE",
                "            WHEN substr(flex_value, 1, 1) = 2 THEN",
                "                n'إستخدامات'",
                "            WHEN substr(flex_value, 1, 1) = 1 THEN",
                "                n'موارد'",
                "            ELSE",
                "                n'أخرى'",
                "        END                      budget_category_type",
                "    FROM",
                "             gfmis_fnd_flex_values_vl v",
                "        INNER JOIN gfmis_fnd_flex_values_tl t ON v.flex_value_id = t.flex_value_id",
                "    WHERE",
                "        flex_value_set_id IN ( 1014151 )",
                "        AND t.language = 'AR'",
                "        AND flex_value = substr(flex_value, 1, 3)",
                "                         || '00000'",
                "        AND flex_value <> substr(flex_value, 1, 2)",
                "                          || '000000'",
                "        AND substr(flex_value, 1, 1) IN ( '1', '2' )",
                "), economic_groups AS (",
                "    SELECT DISTINCT",
                "        substr(flex_value, 1, 4) group_id,",
                "        flex_value               group_code,",
                "        t.description            group_name,",
                "        CASE",
                "            WHEN substr(flex_value, 1, 1) = '5' THEN",
                "                '1'",
                "            ELSE",
                "                substr(flex_value, 2, 1)",
                "        END                      type_id,",
                "        CASE",
                "            WHEN substr(flex_value, 2, 1) IN ( '1' )  THEN",
                "                n'مصروفات و إيرادات جارية'",
                "            WHEN substr(flex_value, 2, 1) IN ( '2' ) THEN",
                "                n'مصروفات و إيرادات رأس مالية'",
                "            ELSE",
                "                n'مصروفات و إيرادات جارية'",
                "        END                      group_type,",
                "        CASE",
                "            WHEN substr(flex_value, 1, 1) = '3'   THEN",
                "                n'إستخدامات'",
                "            WHEN substr(flex_value, 1, 3) = '511' THEN",
                "                n'إستخدامات'",
                "            WHEN substr(flex_value, 1, 3) = '512' THEN",
                "                n'موارد'",
                "            ELSE",
                "                n'موارد'",
                "        END                      budget_category_type,",
                "        CASE",
                "            WHEN substr(flex_value, 1, 1) IN ( '3' ) THEN",
                "                '2'",
                "            WHEN substr(flex_value, 1, 3) = '511' THEN",
                "                '2'",
                "            WHEN substr(flex_value, 1, 3) = '512' THEN",
                "                '1'",
                "            ELSE",
                "                '1'",
                "        END                      budget_category_type_code",
                "    FROM",
                "             gfmis_fnd_flex_values_vl v",
                "        INNER JOIN gfmis_fnd_flex_values_tl t ON v.flex_value_id = t.flex_value_id",
                "    WHERE",
                "        flex_value_set_id IN ( 1017907 )",
                "        AND t.language = 'AR'",
                "        AND flex_value = substr(flex_value, 1, 4)",
                "                         || '000000'",
                "        AND substr(flex_value, 4, 1) NOT IN ( '0' )",
                "        --AND substr(flex_value, 1, 3) IN ( '311', '321', '322', '411', '421', '422', '423', '511', '512' )",
                "    ORDER BY",
                "        1",
                "), budget_categories AS (",
                "    SELECT",
                "        door_id               budget_category_id,",
                "        gbc.door_code         budget_category_code,",
                "        CASE",
                "            WHEN coalesce(ar_name, door_name) IN ( 'الباب السادس : شراء الأصول غير المالية (الاستثمارات)', 'الباب السادس : شراء الأصول غير المالية (الموازنيه)' )",
                "            THEN",
                "                'الباب السادس : شراء الأصول غير المالية'",
                "            ELSE",
                "                coalesce(ar_name, door_name)",
                "        END                   budget_category,",
                "        '0'                   type_id,",
                "        n'لا يوجد'            type,",
                "        budget_category_type,",
                "        substr(door_id, 1, 1) budget_category_type_code,",
                "        'هيئات موازنية'       balancing_or_economic",
                "    FROM",
                "        gfmis_balancing_doors gbc",
                "        LEFT JOIN tsa_budget_categories tbc ON to_char(gbc.door_code) = to_char(tbc.door_code)",
                "    UNION",
                "    SELECT",
                "        group_id,",
                "        group_code,",
                "        group_name,",
                "        type_id,",
                "        group_type,",
                "        budget_category_type,",
                "        budget_category_type_code,",
                "        'هيئات اقتصادية' balancing_or_economic",
                "    FROM",
                "        economic_groups",
                ")",
                "SELECT",
                "    *",
                "FROM",
                "    budget_categories",
                "WHERE",
                "    budget_category_id NOT IN ( '149', '249' )",
                "ORDER BY",
                "    balancing_or_economic,",
                "    budget_category_type",
                "\")",
                "in",
                "    Source"
              ]
            }
          }
        ]
      },
      {
        "name": "GPS_PROJECTS_ELECTRONIC_PAYMENTS",
        "columns": [
          {
            "name": "PAYMENT_ORDER_ID",
            "dataType": "double",
            "sourceColumn": "PAYMENT_ORDER_ID"
          },
          {
            "name": "PAYMENT_ORDER_AMOUNT",
            "dataType": "double",
            "sourceColumn": "PAYMENT_ORDER_AMOUNT"
          },
          {
            "name": "ACCOUNT_AMOUNT",
            "dataType": "double",
            "sourceColumn": "ACCOUNT_AMOUNT"
          },
          {
            "name": "PROJECT_CODE",
            "dataType": "string",
            "sourceColumn": "PROJECT_CODE"
          },
          {
            "name": "PROJECT_NAME",
            "dataType": "string",
            "sourceColumn": "PROJECT_NAME"
          },
          {
            "name": "UNIT_CODE",
            "dataType": "string",
            "sourceColumn": "UNIT_CODE"
          },
          {
            "name": "SETTLEMENT_DATE",
            "dataType": "dateTime",
            "sourceColumn": "SETTLEMENT_DATE"
          },
          {
            "type": "calculated",
            "name": "DATE_KEY",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": " FORMAT(GPS_PROJECTS_ELECTRONIC_PAYMENTS[SETTLEMENT_DATE], \"YYYYMMDD\")"
          }
        ],
        "partitions": [
          {
            "name": "Partition",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Value.NativeQuery(#\"Oracle/oracle-host:1521/oracle_service\", \"",
                "",
                "SELECT",
                "        po.id      payment_order_id,",
                "        po.amount  payment_order_amount,",
                "        nib.amount account_amount,",
                "        nib.code   project_code,",
                "        CASE",
                "            WHEN nib.code IS NULL THEN",
                "                'دائنون'",
                "            ELSE",
                "                to_char(nib.name)",
                "        END        project_name,",
                "        au.code    unit_code,",
                "        po.settlement_date",
                "    FROM",
                "             gps_payment_order po",
                "        INNER JOIN gps_payment_order_nib_project nib ON nib.payment_order_id = po.id",
                "        INNER JOIN gps_accounting_units          au ON au.id = po.acc_unit_id",
                "    WHERE",
                "        nib.po_settlement_date BETWEEN CASE",
                "                                           WHEN to_char(sysdate, 'MMDD') >= '0701' THEN",
                "                                               TO_DATE('01-JUL-' || to_char(sysdate, 'YY'),",
                "                                                       'DD-MON-YY')",
                "                                           ELSE",
                "                                               TO_DATE('01-JUL-'",
                "                                                       || to_char(add_months(sysdate, - 12),",
                "                                                                  'YY'),",
                "                                                       'DD-MON-YY')",
                "                                       END AND CASE",
                "                                                   WHEN to_char(sysdate, 'MMDD') >= '0701' THEN",
                "                                                       TO_DATE('30-JUN-'",
                "                                                               || to_char(add_months(sysdate, 12),",
                "                                                                          'YY'),",
                "                                                               'DD-MON-YY')",
                "                                                   ELSE",
                "                                                       TO_DATE('30-JUN-' || to_char(sysdate, 'YY'),",
                "                                                               'DD-MON-YY')",
                "                                               END",
                "        AND po.executor_id = 2",
                "        AND po.status_id IN ( 8, 9, 20, 21 )",
                "",
                "\")",
                "in",
                "    Source"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "PROJECTS_EP_COUNT",
            "expression": " DISTINCTCOUNT(GPS_PROJECTS_ELECTRONIC_PAYMENTS[PROJECT_CODE])",
            "formatString": "#,0"
          },
          {
            "name": "ELECTRONIC_PAYMENTS_AMOUNT",
            "expression": " SUM(GPS_PROJECTS_ELECTRONIC_PAYMENTS[ACCOUNT_AMOUNT])",
            "formatString": "#,0.00"
          }
        ]
      },
      {
        "name": "GPS_PROJECTS_LKP",
        "columns": [
          {
            "name": "PROJECT_CODE",
            "dataType": "string",
