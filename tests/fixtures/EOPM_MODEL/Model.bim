      {
        "name": "ERP_LKP_ACCOUNT_TYPE",
        "columns": [
          {
            "name": "ACCOUNT_TYPE_ID",
            "dataType": "string",
            "sourceColumn": "ACCOUNT_TYPE_ID"
          },
          {
            "name": "ACCOUT_TYPE",
            "dataType": "string",
            "sourceColumn": "ACCOUT_TYPE"
          }
        ],
        "partitions": [
          {
            "name": "Partition",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Value.NativeQuery(#\"Oracle/oracle-host:1521/oracle_service\", \"   ",
                "",
                "-- ACCOUNT_TYPE",
                "SELECT DISTINCT",
                "    account_type account_type_id,",
                "    CASE",
                "        WHEN account_type = 'A' THEN",
                "            'Assets'",
                "        WHEN account_type = 'D' THEN",
                "            'D'",
                "        WHEN account_type = 'E' THEN",
                "            'Expenses'",
                "        WHEN account_type = 'L' THEN",
                "            'Liability'",
                "        WHEN account_type = 'O' THEN",
                "            'Operating Expenses & Profits'",
                "        WHEN account_type = 'R' THEN",
                "            'Revenue'",
                "        ELSE",
                "            'Unknown'",
                "    END          accout_type",
                "FROM",
                "    erp_api_code_combination",
                "ORDER BY",
                "    1",
                "",
                "\")",
                "in",
                "    Source"
              ]
            }
          }
        ]
      },
