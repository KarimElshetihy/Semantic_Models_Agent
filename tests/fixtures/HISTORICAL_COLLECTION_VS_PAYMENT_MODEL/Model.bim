      {
        "name": "lkp_tsa_budget_category",
        "columns": [
          {
            "name": "BUDGET_CATEGORY_TYPE_NAME",
            "dataType": "string",
            "sourceColumn": "BUDGET_CATEGORY_TYPE_NAME"
          },
          {
            "name": "BUDGET_CATEGORY_ID",
            "dataType": "double",
            "sourceColumn": "BUDGET_CATEGORY_ID"
          },
          {
            "name": "BUDGET_CATEGORY_CODE",
            "dataType": "string",
            "sourceColumn": "BUDGET_CATEGORY_CODE"
          },
          {
            "name": "BUDGET_CATEGORY_TYPE_ID",
            "dataType": "double",
            "sourceColumn": "BUDGET_CATEGORY_TYPE_ID"
          },
          {
            "name": "BUDGET_CATEGORY_TYPE_CODE",
            "dataType": "string",
            "sourceColumn": "BUDGET_CATEGORY_TYPE_CODE"
          },
          {
            "name": "BUDGET_CATEGORY_NAME",
            "dataType": "string",
            "sourceColumn": "BUDGET_CATEGORY_NAME"
          },
          {
            "name": "SW_BUDGET_CODE",
            "dataType": "string",
            "sourceColumn": "SW_BUDGET_CODE"
          },
          {
            "name": "ACCOUNT_TYPE_CODE",
            "dataType": "string",
            "sourceColumn": "ACCOUNT_TYPE_CODE"
          },
          {
            "name": "EPAY_BUDGET_CODE",
            "dataType": "string",
            "sourceColumn": "EPAY_BUDGET_CODE"
          },
          {
            "name": "CCMS_BUDGET_CODE",
            "dataType": "string",
            "sourceColumn": "CCMS_BUDGET_CODE"
          },
          {
            "name": "BUDGET_CATEGORY_CLASS",
            "dataType": "string",
            "sourceColumn": "BUDGET_CATEGORY_CLASS"
          }
        ],
        "partitions": [
          {
            "name": "Partition",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Value.NativeQuery(#\"Oracle/oracle-host:1521/oracle_service\", \"",
                "",
                "SELECT",
                "    budget_category_type_name,",
                "    budget_category_id,",
                "    budget_category_code,",
                "    budget_category_type_id,",
                "    budget_category_type_code,",
                "    budget_category_name,",
                "    to_number(budget_category_code)",
                "    || '-'",
                "    || budget_category_type_id                        AS sw_budget_code,",
                "    CASE",
                "        WHEN budget_category_type_id = 4 THEN",
                "            '05'",
                "        WHEN budget_category_type_id IN ( 1, 2 ) THEN",
                "            '02'",
                "        WHEN budget_category_type_id = 6 THEN",
                "            '08'",
                "    END                                               AS account_type_code,",
                "    budget_category_type_id || budget_category_code   AS epay_budget_code,",
                "    budget_category_code || budget_category_type_code AS ccms_budget_code,",
                "    'كود مؤسسي' budget_category_class",
                "FROM",
                "    oracle_user.lkp_tsa_budget_category",
                "-------------------------------------------------------------------------",
                "UNION ALL",
                "-------------------------------------------------------------------------",
                "SELECT",
                "    'حساب بنك مركزي' budget_category_type_name,",
                "    NULL    budget_category_id,",
                "    NULL    budget_category_code,",
                "    NULL    budget_category_type_id,",
                "    NULL    budget_category_type_code,",
                "    'حساب بنك مركزي' budget_category_name,",
                "    NULL    sw_budget_code,",
                "    NULL    account_type_code,",
                "    'COMM'  epay_budget_code,",
                "    'COMM'  ccms_budget_code,",
                "    'حساب بنك مركزي' budget_category_class",
                "FROM",
                "    dual",
