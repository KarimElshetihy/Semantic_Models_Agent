            "sourceColumn": "PRODUCT_TYPE"
          },
          {
            "name": "BUSINESS_OWNER",
            "dataType": "string",
            "sourceColumn": "BUSINESS_OWNER"
          },
          {
            "name": "TECHNICAL_OWNER",
            "dataType": "string",
            "sourceColumn": "TECHNICAL_OWNER"
          },
          {
            "name": "PROJECT_ID",
            "dataType": "string",
