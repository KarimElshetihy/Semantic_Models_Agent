          },
          {
            "name": "EFFECTIVE_DATE_FROM",
            "dataType": "dateTime",
            "sourceColumn": "EFFECTIVE_DATE_FROM"
          },
          {
            "name": "EFFECTIVE_DATE_TO",
            "dataType": "dateTime",
