            "sourceColumn": "DAY_SHORT_NAME"
          },
          {
            "name": "START_OF_MONTH",
            "dataType": "dateTime",
            "sourceColumn": "START_OF_MONTH"
          },
          {
            "name": "END_OF_MONTH",
            "dataType": "dateTime",
            "sourceColumn": "END_OF_MONTH"
          },
          {
            "name": "START_OF_QUARTER",
            "dataType": "dateTime",
            "sourceColumn": "START_OF_QUARTER"
          },
          {
            "name": "END_OF_QUARTER",
            "dataType": "dateTime",
            "sourceColumn": "END_OF_QUARTER"
          },
          {
            "name": "LAST_REFRESH",
            "dataType": "dateTime",
            "sourceColumn": "LAST_REFRESH",
            "formatString": "MM/dd/yyyy h:mm:ss AM/PM",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"DateTimeCustom\"><DateTimes><DateTime LCID=\"1033\" Group=\"GeneralLongDateTime\" FormatString=\"MM/dd/yyyy h:mm:ss tt\" /></DateTimes></Format>"
              }
            ]
          }
        ],
        "partitions": [
          {
            "name": "Partition",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Value.NativeQuery(#\"Oracle/oracle-host:1521/oracle_service\", \"",
                "",
                "SELECT * FROM (    ",
                "    SELECT",
                "        to_char(to_date(start_date, 'YYYY-MM-DD') + level - 1, 'YYYYMMDD')     AS date_id,",
                "        to_date(start_date, 'YYYY-MM-DD') + level - 1                          AS calendar_date,",
                "        to_char(to_date(start_date, 'YYYY-MM-DD') + level - 1, 'YYYY-MM-DD')   AS calendar_date_formatted,",
                "        to_char(to_date(start_date, 'YYYY-MM-DD') + level - 1, 'YYYY')         AS year,",
                "        to_char(to_date(start_date, 'YYYY-MM-DD') + level - 1, 'Q')            AS quarter,",
                "        EXTRACT(MONTH FROM to_date(start_date, 'YYYY-MM-DD') + level - 1)      AS month,",
                "        to_char(to_date(start_date, 'YYYY-MM-DD') + level - 1, 'MM')           AS month_ch,",
                "        to_char(to_date(start_date, 'YYYY-MM-DD') + level - 1, 'MONTH')        AS month_name,",
                "        to_char(to_date(start_date, 'YYYY-MM-DD') + level - 1, 'MON')          AS month_short_name,",
                "        to_char(to_date(start_date, 'YYYY-MM-DD') + level - 1, 'IW')           AS week,",
                "        to_char(to_date(start_date, 'YYYY-MM-DD') + level - 1, 'DD')           AS day,",
                "        to_char(to_date(start_date, 'YYYY-MM-DD') + level - 1, 'DAY')          AS day_name,",
                "        to_char(to_date(start_date, 'YYYY-MM-DD') + level - 1, 'DY')           AS day_short_name,",
                "        trunc(to_date(start_date, 'YYYY-MM-DD') + level - 1, 'MM')             AS start_of_month,",
                "        last_day(to_date(start_date, 'YYYY-MM-DD') + level - 1)                AS end_of_month,",
                "        trunc(to_date(start_date, 'YYYY-MM-DD') + level - 1, 'Q')              AS start_of_quarter,",
                "        last_day(add_months(to_date(start_date, 'YYYY-MM-DD') + level - 1, 2)) AS end_of_quarter,",
                "        systimestamp                                                           last_refresh",
                "    FROM",
                "        (",
                "            SELECT",
                "                '2009-01-01' AS start_date",
                "            FROM",
                "                dual",
                "        )",
                "    CONNECT BY",
                "        level <= ( trunc(sysdate) - to_date(start_date, 'YYYY-MM-DD') + 1 ))",
                "WHERE year <= to_char(SYSDATE, 'YYYY')",
                "",
                "\")",
                "in",
                "    Source"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "TXN_COUNT_",
            "expression": " [EPay_TRX_COUNT] + GOV[GOV_TRX_COUNT] + CHEQUE[CH_TRX_COUNT] + 0",
            "formatString": "#,0"
          },
          {
            "name": "TXN_AMT_",
            "expression": " [EP_TRX_AMT] + GOV[GOV_TRX_AMT] + CHEQUE[CH_TRX_AMT] + 0",
            "formatString": "#,0.00"
          }
        ]
      },
      {
        "name": "ACCOUNTING_UNITS",
        "columns": [
          {
            "name": "AU_TSA_ID",
            "dataType": "string",
            "sourceColumn": "AU_TSA_ID"
          },
          {
            "name": "FUNCTIONAL_CHILD",
            "dataType": "string",
            "sourceColumn": "FUNCTIONAL_CHILD"
          },
          {
            "name": "MINISTRY",
            "dataType": "string",
            "sourceColumn": "MINISTRY"
          },
          {
            "name": "MINISTRY_CODE",
            "dataType": "string",
            "sourceColumn": "MINISTRY_CODE"
          },
          {
            "name": "UNIT_CODE",
            "dataType": "string",
            "sourceColumn": "UNIT_CODE"
          },
          {
            "name": "UNIT_NAME",
            "dataType": "string",
            "sourceColumn": "UNIT_NAME"
          },
          {
            "name": "AREA_CODE",
            "dataType": "string",
            "sourceColumn": "AREA_CODE"
          },
          {
            "name": "AREA_NAME",
            "dataType": "string",
            "sourceColumn": "AREA_NAME"
          },
          {
            "name": "UNIT_TYPE",
            "dataType": "string",
            "sourceColumn": "UNIT_TYPE"
          },
          {
            "name": "INSTITUTION_CODE",
            "dataType": "string",
            "sourceColumn": "INSTITUTION_CODE"
          },
          {
            "name": "INSTITUTION_NAME",
            "dataType": "string",
            "sourceColumn": "INSTITUTION_NAME"
          },
          {
            "name": "INSTITUTIONAL_SECTOR_CODE",
            "dataType": "string",
            "sourceColumn": "INSTITUTIONAL_SECTOR_CODE"
          },
          {
            "name": "INSTITUTIONAL_SECTOR_NAME",
            "dataType": "string",
            "sourceColumn": "INSTITUTIONAL_SECTOR_NAME"
          },
          {
            "name": "FUNCTIONAL_SECTOR_ID",
            "dataType": "string",
            "sourceColumn": "FUNCTIONAL_SECTOR_ID"
          },
          {
            "name": "FUNCTIONAL_SECTOR",
            "dataType": "string",
            "sourceColumn": "FUNCTIONAL_SECTOR"
          },
          {
            "name": "CLASSIFCATION",
            "dataType": "string",
            "sourceColumn": "CLASSIFCATION"
          },
          {
            "type": "calculated",
            "name": "UNIT_NAME_",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": " IF(ACCOUNTING_UNITS[UNIT_NAME] = \"و.ح للإدارة العامة للجمارك بالإسكندرية\", \"الإيداع بالحساب الجاري الجمركي\" ,ACCOUNTING_UNITS[UNIT_NAME])"
          },
          {
            "type": "calculated",
            "name": "UNIT_CODE_NAME",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": " ACCOUNTING_UNITS[UNIT_CODE] & \"-\" & ACCOUNTING_UNITS[UNIT_NAME]"
          }
        ],
        "partitions": [
          {
            "name": "Partition",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Value.NativeQuery(#\"Oracle/oracle-host:1521/oracle_service\", \"",
                "",
                "SELECT",
                "    to_char(au_tsa_id)                  au_tsa_id,",
                "    coalesce(unit_code,",
                "             to_char(au_code))          unit_code,",
                "    coalesce(unit_name, au_name)        unit_name,",
                "    coalesce(area_code,",
                "             to_char(l3_code))          area_code,",
                "    coalesce(area_name, l3_name)        area_name,",
                "    coalesce(institution_code,",
                "             to_char(l2_code))          institution_code,",
                "    coalesce(institution_name, l2_name) institution_name,",
                "    ministry_code,",
                "    ministry,",
                "    CASE",
                "        WHEN substr(au_code, 1, 1) = 1 THEN",
                "            '10000000'",
                "        WHEN substr(au_code, 1, 1) = 2 THEN",
                "            '20000000'",
                "        WHEN substr(au_code, 1, 1) = 3 THEN",
                "            '30000000'",
                "        WHEN substr(au_code, 1, 1) = 4 THEN",
                "            '40000000'",
                "        ELSE",
                "            institutional_sector_code",
                "    END                                 institutional_sector_code,",
                "    CASE",
                "        WHEN substr(au_code, 1, 1) = 1 THEN",
                "            'الجهاز الإدارى'",
                "        WHEN substr(au_code, 1, 1) = 2 THEN",
                "            'الإدارة المحلية'",
                "        WHEN substr(au_code, 1, 1) = 3 THEN",
                "            'الهيئات العامة الخدمية'",
                "        WHEN substr(au_code, 1, 1) = 4 THEN",
                "            'الهيئات الإقتصادية'",
                "        ELSE",
                "            institutional_sector_name",
                "    END                                 institutional_sector_name,",
                "    functional_sector_id,",
                "    coalesce(functional_sector, 'أخرى') functional_sector,",
                "    coalesce(functional_child, 'أخرى')  functional_child,",
                "    CASE",
                "        WHEN substr(au_code, 1, 1) IN ( 1, 2, 3 ) THEN",
                "            n'هيئة موازنية'",
                "        WHEN substr(au_code, 1, 1) = 4 THEN",
                "            n'هيئة إقتصادية'",
                "        ELSE",
                "            unit_type",
                "    END                                 unit_type,",
                "    CASE",
                "        WHEN area_code IN ( '10600700', '10601800', '10600900' ) THEN -- '10600500',",
                "            n'مصلحة الضرائب المصرية'",
                "        WHEN area_code IN ( '10600600' ) THEN",
                "            n'مصلحة الجمارك المصرية'",
                "        ELSE",
                "            CASE",
                "                    WHEN substr(au_code, 1, 1) IN ( 1, 2, 3 ) THEN",
                "                        n'هيئة موازنية'",
                "                    WHEN substr(au_code, 1, 1) = 4 THEN",
                "                        n'هيئة إقتصادية'",
                "                    ELSE",
                "                        unit_type",
                "            END",
                "    END                                 classifcation",
                "FROM",
                "    gfmis_au_hierarchy_master mau",
                "    RIGHT JOIN lkp_accounting_units      au ON substr(au.au_code, 1, 8) = mau.unit_code",
                "--------------------------------------------------------------------------------",
                "UNION ALL",
                "--------------------------------------------------------------------------------",
                "SELECT",
                "    'COMM'   au_tsa_id,",
                "    NULL     unit_code,",
                "    'تجاري'  unit_name,",
                "    NULL     area_code,",
                "    'تجاري'  area_name,",
                "    NULL     institution_code,",
                "    'تجاري'  institution_name,",
                "    NULL     ministry_code,",
                "    'تجاري'  ministry,",
                "    NULL     institutional_sector_code,",
                "    'تجاري'  institutional_sector_name,",
                "    NULL     functional_sector_id,",
                "    'تجاري'  functional_sector,",
                "    NULL     functional_child,",
                "    n'أخرى'  unit_type,",
                "    n'تجاري' classifcation",
                "FROM",
                "    dual",
                "--------------------------------------------------------------------------------",
                "UNION ALL",
                "--------------------------------------------------------------------------------",
                "SELECT",
                "    'MUSEUM'                     au_tsa_id,",
                "    NULL                         unit_code,",
                "    'الترفيه و الثقافة و الدين'  unit_name,",
                "    NULL                         area_code,",
                "    'الترفيه و الثقافة و الدين'  area_name,",
                "    NULL                         institution_code,",
                "    'الترفيه و الثقافة و الدين'  institution_name,",
                "    NULL                         ministry_code,",
                "    'الترفيه و الثقافة و الدين'  ministry,",
                "    NULL                         institutional_sector_code,",
                "    'الترفيه و الثقافة و الدين'  institutional_sector_name,",
                "    NULL                         functional_sector_id,",
                "    'الترفيه و الثقافة و الدين'  functional_sector,",
                "    NULL                         functional_child,",
                "    n'أخرى'                      unit_type,",
                "    n'الترفيه و الثقافة و الدين' classifcation",
                "FROM",
                "    dual",
                "",
                "\")",
                "in",
                "    Source"
              ]
            }
          }
        ]
      },
